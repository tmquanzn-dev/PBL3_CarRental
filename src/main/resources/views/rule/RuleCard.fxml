<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="cardContainer" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="220.0" prefWidth="320.0"
      spacing="0.0"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://fxml.com/fx/1"
      fx:controller="com.example.rentalcar.controller.rule.RuleCardController"
      style="-fx-background-color: white;
             -fx-background-radius: 14;
             -fx-border-color: #e2e8f0;
             -fx-border-radius: 14;
             -fx-border-width: 1.5;
             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 14, 0, 0, 4);">
    <children>
        <AnchorPane fx:id="accentBar" prefHeight="6.0"
                    style="-fx-background-color: -fx-accent-color; -fx-background-radius: 12 12 0 0;" />

        <VBox spacing="10.0" VBox.vgrow="ALWAYS">
            <padding><Insets bottom="16.0" left="18.0" right="18.0" top="14.0" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Label fx:id="lblType"
                               style="-fx-background-color: -fx-badge-bg; -fx-text-fill: -fx-badge-fg;
                                      -fx-padding: 3 10; -fx-background-radius: 20;
                                      -fx-font-weight: bold; -fx-font-size: 10px;"
                               text="CUỐI TUẦN" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblStatusBadge"
                               style="-fx-background-color: #dcfce7; -fx-text-fill: #16a34a;
                                      -fx-padding: 3 10; -fx-background-radius: 20;
                                      -fx-font-weight: bold; -fx-font-size: 10px;"
                               text="● Bật" />
                    </children>
                </HBox>

                <Label fx:id="lblMulti"
                       style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: -fx-accent-color;"
                       text="x1.20">
                    <font><Font name="System Bold" size="36.0" /></font>
                </Label>

                <Label fx:id="lblName"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"
                       text="Tên luật" wrapText="true" />

                <Label fx:id="lblDate"
                       style="-fx-font-size: 12px; -fx-text-fill: #64748b;"
                       text="📅  01/01/2026  →  31/12/2026" />

                <Region VBox.vgrow="ALWAYS" />
                <Region prefHeight="1.0" style="-fx-background-color: #f1f5f9;" />

                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                    <children>
                        <Button onAction="#handleToggle" prefHeight="32.0"
                                style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569;
                                       -fx-background-radius: 8; -fx-background-insets: 0;
                                       -fx-cursor: hand; -fx-font-size: 11px;
                                       -fx-font-weight: bold; -fx-padding: 0 10;"
                                text="⏯  Bật/Tắt" />
                        <Button onAction="#handleEdit" prefHeight="32.0" prefWidth="70.0"
                                style="-fx-background-color: #fef3c7; -fx-text-fill: #b45309;
                                       -fx-background-radius: 8; -fx-background-insets: 0;
                                       -fx-cursor: hand; -fx-font-size: 11px; -fx-font-weight: bold;"
                                text="✏  Sửa" />
                        <Button onAction="#handleDelete" prefHeight="32.0" prefWidth="64.0"
                                style="-fx-background-color: #fee2e2; -fx-text-fill: #b91c1c;
                                       -fx-background-radius: 8; -fx-background-insets: 0;
                                       -fx-cursor: hand; -fx-font-size: 11px; -fx-font-weight: bold;"
                                text="🗑  Xóa" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>