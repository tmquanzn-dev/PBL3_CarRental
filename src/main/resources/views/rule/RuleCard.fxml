<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="-Infinity" minWidth="-Infinity" prefHeight="220.0" prefWidth="330.0" spacing="12.0" styleClass="rule-card" stylesheets="@../../css/ruleview/rulestyle.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.rentalcar.controller.rule.RuleCardController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <Label fx:id="lblType" styleClass="badge-type" text="NGÀY LỄ" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblMulti" styleClass="text-multi" text="x1.5" />
            </children>
        </HBox>

        <VBox spacing="5.0">
            <children>
                <Label fx:id="lblName" styleClass="section-title" text="Tên quy luật" />
                <Label fx:id="lblDate" style="-fx-text-fill: #64748b;" text="01/01/2026 - 15/01/2026" />
            </children>
        </VBox>

        <Region VBox.vgrow="ALWAYS" />

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button onAction="#handleEdit" prefHeight="35.0" prefWidth="80.0" styleClass="btn-edit" text="Sửa" />
                <Button onAction="#handleDelete" prefHeight="35.0" prefWidth="80.0" styleClass="btn-delete" text="Xóa" />
            </children>
        </HBox>
    </children>
</VBox>