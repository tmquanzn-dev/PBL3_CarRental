<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="1176.0" prefWidth="1100.0" spacing="25.0"
      stylesheets="@../../css/partpriceview/partpricestyle.css"
      xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.rentalcar.controller.partprice.PartPriceController">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>

    <children>
        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT" prefHeight="46.0">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Quản lý giá phụ tùng">
                            <font><Font name="System Bold" size="30.0"/></font>
                        </Text>
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"
                               text="Bảng giá phụ tùng áp dụng khi tính phạt hư hỏng xe"/>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" onAction="#handleAddNewPart"
                        prefHeight="46.0" prefWidth="220.0" styleClass="btn-new"
                        text="＋  Thêm phụ tùng" textFill="WHITE">
                    <font><Font name="System Bold" size="15.0"/></font>
                </Button>
            </children>
        </HBox>

        <!-- STAT CARDS -->
        <HBox prefHeight="110.0" spacing="20.0">
            <children>
                <AnchorPane prefHeight="110.0" styleClass="card-blue" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: linear-gradient(to bottom right,#478dff,#146dff);
                                   -fx-background-radius:12; -fx-effect:dropshadow(three-pass-box,rgba(0,0,0,0.10),15,0,0,8);">
                    <children>
                        <Label style="-fx-text-fill:white;-fx-font-size:14px;-fx-opacity:0.9;"
                               text="Tổng phụ tùng" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0"/>
                        <Label fx:id="lblTotalParts" style="-fx-text-fill:white;-fx-font-size:30px;-fx-font-weight:bold;"
                               text="--" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="38.0"/>
                        <Label style="-fx-text-fill:white;-fx-font-size:12px;-fx-opacity:0.85;"
                               text="Mục trong bảng giá" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="78.0"/>
                        <Label style="-fx-text-fill:white;-fx-font-size:34px;-fx-opacity:0.2;"
                               text="🔧" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0"/>
                    </children>
                </AnchorPane>

                <AnchorPane prefHeight="110.0" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: linear-gradient(to bottom right,#34d399,#10b981);
                                   -fx-background-radius:12; -fx-effect:dropshadow(three-pass-box,rgba(0,0,0,0.10),15,0,0,8);">
                    <children>
                        <Label style="-fx-text-fill:white;-fx-font-size:14px;-fx-opacity:0.9;"
                               text="Giá trung bình" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0"/>
                        <Label fx:id="lblAvgPrice" style="-fx-text-fill:white;-fx-font-size:20px;-fx-font-weight:bold;"
                               text="--" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="40.0"/>
                        <Label style="-fx-text-fill:white;-fx-font-size:12px;-fx-opacity:0.85;"
                               text="Tính trên toàn bộ danh mục" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="78.0"/>
                        <Label style="-fx-text-fill:white;-fx-font-size:34px;-fx-opacity:0.2;"
                               text="💰" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0"/>
                    </children>
                </AnchorPane>

                <AnchorPane prefHeight="110.0" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: linear-gradient(to bottom right,#a855f7,#7c3aed);
                                   -fx-background-radius:12; -fx-effect:dropshadow(three-pass-box,rgba(0,0,0,0.10),15,0,0,8);">
                    <children>
                        <Label style="-fx-text-fill:white;-fx-font-size:14px;-fx-opacity:0.9;"
                               text="Loại xe áp dụng" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0"/>
                        <Label fx:id="lblVehicleTypes" style="-fx-text-fill:white;-fx-font-size:30px;-fx-font-weight:bold;"
                               text="--" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="38.0"/>
                        <Label style="-fx-text-fill:white;-fx-font-size:12px;-fx-opacity:0.85;"
                               text="Nhóm loại xe phân biệt" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="78.0"/>
                        <Label style="-fx-text-fill:white;-fx-font-size:34px;-fx-opacity:0.2;"
                               text="🏍" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0"/>
                    </children>
                </AnchorPane>
            </children>
        </HBox>

        <!-- SEARCH & FILTER BAR -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <TextField fx:id="txtSearch" prefHeight="42.0" prefWidth="300.0"
                           promptText="🔍  Tìm tên phụ tùng..."
                           styleClass="search-field"/>
                <ComboBox fx:id="cbVehicleType" prefHeight="42.0" prefWidth="180.0"
                          promptText="Lọc theo loại xe"
                          style="-fx-background-color: white; -fx-border-color: #cbd5e1;
                                 -fx-border-radius: 8; -fx-background-radius: 8;
                                 -fx-pref-height: 42px; -fx-font-size: 14px;"
                          onAction="#handleFilter"/>
                <Button mnemonicParsing="false" onAction="#handleSearch"
                        prefHeight="42.0" prefWidth="110.0" styleClass="btn-search"
                        text="Tìm kiếm">
                    <font><Font name="System Bold" size="13.0"/></font>
                </Button>
                <Button mnemonicParsing="false" onAction="#handleReload"
                        prefHeight="42.0" prefWidth="90.0" styleClass="btn-refresh"
                        text="Làm mới">
                    <font><Font name="System Bold" size="13.0"/></font>
                </Button>
            </children>
        </HBox>

        <!-- TABLE CONTAINER -->
        <VBox spacing="0.0" styleClass="table-container" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="16.0" left="20.0" right="20.0" top="16.0"/>
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 12 0;">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #1e293b;"
                               text="Danh sách phụ tùng"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblCount"
                               style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;
                                      -fx-background-color: #f1f5f9; -fx-padding: 4 12;
                                      -fx-background-radius: 12;"
                               text="0 phụ tùng"/>
                    </children>
                </HBox>

                <TableView fx:id="tablePartPrices" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colId"    maxWidth="80.0"  minWidth="80.0"  text="STT"/>
                        <TableColumn fx:id="colName"  prefWidth="320.0" text="TÊN PHỤ TÙNG"/>
                        <TableColumn fx:id="colType"  prefWidth="200.0" text="LOẠI XE ÁP DỤNG"/>
                        <TableColumn fx:id="colPrice" prefWidth="180.0" text="ĐƠN GIÁ (VNĐ)"/>
                        <TableColumn fx:id="colAction" maxWidth="120.0" minWidth="120.0" text="THAO TÁC"/>
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>