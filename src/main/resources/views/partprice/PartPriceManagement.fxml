<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="1176.0" prefWidth="1100.0" spacing="25.0" styleClass="part-page-container" stylesheets="@../../css/partpriceview/partpricestyle.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.rentalcar.controller.partprice.PartPriceController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="46.0">
            <children>
                <Label styleClass="header-title" text="Quản lý giá phụ tùng" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#handleAddNewPart" prefHeight="45.0" prefWidth="220.0" styleClass="btn-new" text="+ Thêm phụ tùng" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font></Button>
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="15.0">
            <children>
                <TextField fx:id="txtSearch" prefHeight="45.0" prefWidth="350.0" promptText="🔍 Nhập tên phụ tùng..." styleClass="search-field" />
                <Button mnemonicParsing="false" prefHeight="45.0" prefWidth="120.0" styleClass="btn-search" text="Tìm kiếm" />
                <Button mnemonicParsing="false" prefHeight="45.0" prefWidth="120.0" styleClass="btn-refresh" text="Làm mới" />
            </children>
        </HBox>

        <VBox spacing="15.0" styleClass="table-container" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label styleClass="section-title" text="Bảng giá tham khảo" />
                <TableView fx:id="tablePartPrices" prefHeight="600.0" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colId" maxWidth="80.0" minWidth="80.0" text="Mã PT" />
                        <TableColumn fx:id="colName" prefWidth="250.0" text="Tên Phụ Tùng" />
                        <TableColumn fx:id="colType" prefWidth="150.0" text="Loại Xe Áp Dụng" />
                        <TableColumn fx:id="colPrice" prefWidth="150.0" text="Đơn Giá (VNĐ)" />
                        <TableColumn fx:id="colAction" maxWidth="150.0" minWidth="150.0" text="Hành Động" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
