<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="-Infinity" minWidth="-Infinity" prefHeight="350.0" prefWidth="301.0" styleClass="vehicle-card" stylesheets="@../../css/vehicleview/vehiclestyle.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.rentalcar.controller.vehicle.VehicleCardController">
    <children>
        <StackPane prefHeight="160.0" prefWidth="320.0" styleClass="vehicle-image-container">
            <children>
                <ImageView fx:id="imgVehicle" fitHeight="150.0" fitWidth="280.0" pickOnBounds="true" preserveRatio="true" />
            </children>
        </StackPane>

        <VBox prefHeight="199.0" prefWidth="298.0" spacing="10.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label fx:id="lblPlate" styleClass="plate-text" text="43A-123.45" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblStatus" styleClass="badge-available" text="AVAILABLE" />
                    </children>
                </HBox>

                <Label fx:id="lblName" styleClass="section-title" text="Honda SH Mode 2024" />

                <HBox alignment="BOTTOM_LEFT" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox>
                            <children>
                                <Label text="Giá thuê/ngày:" textFill="#64748b" />
                                <Label fx:id="lblPrice" styleClass="price-text" text="150,000 đ" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 10 0 0 0;">
                    <children>
                        <Button onAction="#handleEdit" prefHeight="35.0" prefWidth="80.0" styleClass="btn-edit" text="Sửa" />
                        <Button onAction="#handleDelete" prefHeight="35.0" prefWidth="80.0" styleClass="btn-delete" text="Xóa" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
