<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="700.0" spacing="15.0" styleClass="modal-container"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.rentalcar.controller.vehicle.AddVehicleController">
    <padding>
        <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
    </padding>
    <children>

        <!-- HEADER -->
        <VBox spacing="3.0">
            <children>
                <Label styleClass="header-title" text="Thêm phương tiện mới" />
                <Label style="-fx-text-fill: #64748b; -fx-font-size: 13px;"
                       text="Vui lòng điền thông tin kỹ thuật và định mức giá" />
            </children>
        </VBox>

        <!-- FORM CÁC TRƯỜNG NHẬP -->
        <GridPane hgap="20.0" vgap="12.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>

                <VBox spacing="3.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label styleClass="input-label" text="Biển số xe *" />
                    <TextField fx:id="txtCode" promptText="VD: 43A-123.45" styleClass="modern-input" />
                </VBox>

                <VBox spacing="3.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label styleClass="input-label" text="Hãng xe" />
                    <TextField fx:id="txtBrand" promptText="VD: Honda, Yamaha..." styleClass="modern-input" />
                </VBox>

                <VBox spacing="3.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label styleClass="input-label" text="Dòng xe (Model)" />
                    <TextField fx:id="txtModel" promptText="VD: Vision, SH Mode..." styleClass="modern-input" />
                </VBox>

                <VBox spacing="3.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label styleClass="input-label" text="Loại xe *" />
                    <ComboBox fx:id="cbType" maxWidth="Infinity" promptText="Chọn loại xe" styleClass="modern-combo" />
                </VBox>

                <VBox spacing="3.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label styleClass="input-label" text="Màu sắc" />
                    <TextField fx:id="txtColor" promptText="VD: Trắng, Đỏ nhám..." styleClass="modern-input" />
                </VBox>

                <VBox spacing="3.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Label styleClass="input-label" text="Năm sản xuất" />
                    <TextField fx:id="txtYear" promptText="VD: 2024" styleClass="modern-input" />
                </VBox>

                <VBox spacing="3.0" GridPane.columnIndex="0" GridPane.rowIndex="3">
                    <Label styleClass="input-label" text="Giá thuê / Ngày (VNĐ) *" />
                    <TextField fx:id="txtPriceDay" promptText="150000" styleClass="modern-input" />
                </VBox>

                <VBox spacing="3.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <Label styleClass="input-label" text="Giá thuê / Giờ (VNĐ) *" />
                    <TextField fx:id="txtPriceHour" promptText="20000" styleClass="modern-input" />
                </VBox>

                <VBox spacing="3.0" GridPane.columnIndex="0" GridPane.rowIndex="4">
                    <Label styleClass="input-label" text="Số KM hiện tại" />
                    <TextField fx:id="txtCurrentKm" promptText="0" styleClass="modern-input" />
                </VBox>

                <VBox spacing="3.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
                    <Label styleClass="input-label" text="Mốc bảo dưỡng (KM) *" />
                    <TextField fx:id="txtMaintenanceKm" promptText="5000" styleClass="modern-input" />
                </VBox>

                <VBox spacing="3.0" GridPane.columnSpan="2" GridPane.rowIndex="5">
                    <Label styleClass="input-label" text="Giá trị mua xe (Dùng tính ROI)" />
                    <TextField fx:id="txtPurchasePrice" promptText="40000000" styleClass="modern-input" />
                </VBox>

            </children>
        </GridPane>

        <!-- ====================================================
             UPLOAD ẢNH XE – có preview to và nút chọn ảnh rõ ràng
        ==================================================== -->
        <VBox spacing="10.0"
              style="-fx-border-color: #cbd5e1; -fx-border-style: dashed; -fx-border-width: 2;
                     -fx-background-color: #f8fafc; -fx-background-radius: 12; -fx-border-radius: 12;
                     -fx-padding: 16;">
            <children>

                <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 13px;"
                       text="📷  Ảnh phương tiện" />

                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>

                        <!-- Preview ảnh -->
                        <StackPane prefWidth="200.0" prefHeight="130.0"
                                   style="-fx-background-color: #e2e8f0; -fx-background-radius: 10;
                                          -fx-border-color: #cbd5e1; -fx-border-radius: 10; -fx-border-width: 1;">
                            <children>
                                <ImageView fx:id="imgVehiclePreview"
                                           fitWidth="196.0" fitHeight="126.0"
                                           preserveRatio="true" pickOnBounds="true" />
                            </children>
                        </StackPane>

                        <!-- Nút và trạng thái -->
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Chọn ảnh xe để hiển thị trên card"
                                       style="-fx-text-fill: #64748b; -fx-font-size: 13px;" />
                                <Label text="Định dạng: JPG, PNG, WEBP • Tối đa: 5MB"
                                       style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" />

                                <Button fx:id="btnUploadImage"
                                        mnemonicParsing="false"
                                        onAction="#handleUploadVehicleImage"
                                        prefHeight="40.0" prefWidth="160.0"
                                        style="-fx-background-color: #146dff; -fx-text-fill: white;
                                               -fx-background-radius: 8; -fx-cursor: hand;
                                               -fx-font-weight: bold; -fx-font-size: 13px;"
                                        text="📂  Chọn ảnh từ máy tính" />

                                <!-- Label trạng thái (ẩn mặc định) -->
                                <Label fx:id="lblImagePath"
                                       text=""
                                       style="-fx-text-fill: #16a34a; -fx-font-size: 12px; -fx-font-weight: bold;"
                                       visible="false" managed="false" />
                            </children>
                        </VBox>

                    </children>
                </HBox>

            </children>
        </VBox>

        <!-- BUTTONS -->
        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <VBox.margin><Insets top="5.0" /></VBox.margin>
            <children>
                <Button mnemonicParsing="false" onAction="#handleCancel" styleClass="btn-cancel" text="Hủy bỏ" />
                <Button mnemonicParsing="false" onAction="#handleSave"   styleClass="btn-primary" text="💾  Lưu phương tiện" />
            </children>
        </HBox>

    </children>

    <stylesheets>
        <URL value="@../../css/vehicleview/formstyle.css" />
    </stylesheets>
</VBox>
