<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<!--
    EmployeeManagement.fxml
    Admin : thấy nút "+ Thêm nhân viên", các card có nút Sửa/Khóa/Reset
    Staff : ẩn nút Thêm, card chỉ xem thông tin (xử lý trong EmployeeCardController)
-->
<VBox maxHeight="-Infinity" maxWidth="-Infinity"
      minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="1176.0" prefWidth="1100.0"
      spacing="24.0"
      style="-fx-background-color: #f4f7f6;"
      stylesheets="@../../css/employeeview/employeestyle.css"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.rentalcar.controller.employee.EmployeeController">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="28.0" />
    </padding>

    <children>

        <!-- ===== HEADER ===== -->
        <HBox alignment="CENTER_LEFT" prefHeight="46.0">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0"
                              text="Quản lý nhân viên">
                            <font><Font name="System Bold" size="30.0" /></font>
                        </Text>
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"
                               text="Danh sách tài khoản nhân viên trong hệ thống" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />

                <!--
                    fx:id="btnAddEmployee" → MainController.applyRoleMenu() sẽ ẩn với Staff
                    Nếu muốn tự ẩn trong EmployeeController thì đã có guard isAdmin() bên trong
                -->
                <Button fx:id="btnAddEmployee"
                        mnemonicParsing="false"
                        onAction="#showAddEmployeeModal"
                        prefHeight="46.0" prefWidth="210.0"
                        styleClass="btn-new"
                        text="＋  Thêm nhân viên"
                        textFill="WHITE">
                    <font><Font name="System Bold" size="15.0" /></font>
                </Button>
            </children>
        </HBox>

        <!-- ===== 3 STAT CARDS ===== -->
        <HBox prefHeight="110.0" spacing="20.0">
            <children>

                <!-- Tổng nhân viên -->
                <AnchorPane prefHeight="110.0" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: linear-gradient(to bottom right,#478dff,#146dff);
                                   -fx-background-radius:12;
                                   -fx-effect:dropshadow(three-pass-box,rgba(0,0,0,0.10),15,0,0,8);">
                    <children>
                        <Label style="-fx-text-fill:white;-fx-font-size:14px;-fx-opacity:0.92;"
                               text="Tổng nhân viên"
                               AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0"/>
                        <Label fx:id="lblTotalStaff"
                               style="-fx-text-fill:white;-fx-font-size:30px;-fx-font-weight:bold;"
                               text="--"
                               AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="40.0"/>
                        <Label style="-fx-text-fill:white;-fx-font-size:12px;-fx-opacity:0.85;"
                               text="Tài khoản trong hệ thống"
                               AnchorPane.leftAnchor="18.0" AnchorPane.bottomAnchor="12.0"/>
                        <Label style="-fx-text-fill:white;-fx-font-size:34px;-fx-opacity:0.18;"
                               text="👥"
                               AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="12.0"/>
                    </children>
                </AnchorPane>

                <!-- Đang hoạt động -->
                <AnchorPane prefHeight="110.0" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: linear-gradient(to bottom right,#34d399,#10b981);
                                   -fx-background-radius:12;
                                   -fx-effect:dropshadow(three-pass-box,rgba(0,0,0,0.10),15,0,0,8);">
                    <children>
                        <Label style="-fx-text-fill:white;-fx-font-size:14px;-fx-opacity:0.92;"
                               text="Đang hoạt động"
                               AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0"/>
                        <Label fx:id="lblActiveStaff"
                               style="-fx-text-fill:white;-fx-font-size:30px;-fx-font-weight:bold;"
                               text="--"
                               AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="40.0"/>
                        <Label style="-fx-text-fill:white;-fx-font-size:12px;-fx-opacity:0.85;"
                               text="Tài khoản chưa bị khóa"
                               AnchorPane.leftAnchor="18.0" AnchorPane.bottomAnchor="12.0"/>
                        <Label style="-fx-text-fill:white;-fx-font-size:34px;-fx-opacity:0.18;"
                               text="✅"
                               AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="12.0"/>
                    </children>
                </AnchorPane>

                <!-- Đã khóa -->
                <AnchorPane prefHeight="110.0" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: linear-gradient(to bottom right,#f87171,#ef4444);
                                   -fx-background-radius:12;
                                   -fx-effect:dropshadow(three-pass-box,rgba(0,0,0,0.10),15,0,0,8);">
                    <children>
                        <Label style="-fx-text-fill:white;-fx-font-size:14px;-fx-opacity:0.92;"
                               text="Đã khóa"
                               AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0"/>
                        <Label fx:id="lblLockedStaff"
                               style="-fx-text-fill:white;-fx-font-size:30px;-fx-font-weight:bold;"
                               text="--"
                               AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="40.0"/>
                        <Label style="-fx-text-fill:white;-fx-font-size:12px;-fx-opacity:0.85;"
                               text="Tài khoản bị vô hiệu hóa"
                               AnchorPane.leftAnchor="18.0" AnchorPane.bottomAnchor="12.0"/>
                        <Label style="-fx-text-fill:white;-fx-font-size:34px;-fx-opacity:0.18;"
                               text="🔒"
                               AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="12.0"/>
                    </children>
                </AnchorPane>

            </children>
        </HBox>

        <!-- ===== SEARCH BAR ===== -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <TextField fx:id="txtSearch"
                           prefHeight="44.0" prefWidth="360.0"
                           promptText="🔍  Tìm tên nhân viên, username..."
                           style="-fx-background-color: white; -fx-background-radius: 8;
                                  -fx-border-color: #cbd5e1; -fx-border-radius: 8;
                                  -fx-padding: 0 12; -fx-font-size: 14px;">
                    <font><Font size="14.0" /></font>
                </TextField>

                <Button mnemonicParsing="false" onAction="#handleSearch"
                        prefHeight="44.0" prefWidth="110.0"
                        style="-fx-background-color: #0ea5e9; -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;"
                        text="Tìm kiếm">
                    <font><Font name="System Bold" size="13.0" /></font>
                </Button>

                <Button mnemonicParsing="false" onAction="#handleReload"
                        prefHeight="44.0" prefWidth="90.0"
                        style="-fx-background-color: #64748b; -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;"
                        text="Làm mới">
                    <font><Font name="System Bold" size="13.0" /></font>
                </Button>
            </children>
        </HBox>

        <!-- ===== DANH SÁCH CARD ===== -->
        <VBox spacing="12.0"
              style="-fx-background-color: white; -fx-background-radius: 14;
                     -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);"
              VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="16.0" />
            </padding>
            <children>

                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 17px; -fx-text-fill: #1e293b;"
                               text="Danh sách nhân viên" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblCount"
                               style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;
                                      -fx-background-color: #f1f5f9; -fx-padding: 4 12;
                                      -fx-background-radius: 12;"
                               text="0 nhân viên" />
                    </children>
                </HBox>

                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            style="-fx-background-color: transparent; -fx-background: transparent;"
                            VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="employeeContainer"
                                  hgap="20.0" vgap="20.0">
                            <padding>
                                <Insets bottom="10.0" left="4.0" right="4.0" top="4.0" />
                            </padding>
                        </FlowPane>
                    </content>
                </ScrollPane>

            </children>
        </VBox>

    </children>
</VBox>
