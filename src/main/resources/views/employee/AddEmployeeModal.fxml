<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="580.0" spacing="18.0"
      style="-fx-background-color: white; -fx-background-radius: 14;"
      stylesheets="@../../css/employeeview/employeestyle.css"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.rentalcar.controller.employee.AddEmployeeController">

    <padding>
        <Insets bottom="28.0" left="34.0" right="34.0" top="24.0" />
    </padding>

    <children>

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox spacing="3.0">
                    <children>
                        <Label text="Thêm nhân viên mới"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                        <Label text="Điền đầy đủ thông tin để tạo tài khoản nhân viên"
                               style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#handleClose"
                        style="-fx-background-color: transparent; -fx-text-fill: #64748b;
                               -fx-font-size: 20px; -fx-cursor: hand;"
                        text="✕" />
            </children>
        </HBox>

        <Separator />

        <!-- FORM -->
        <GridPane hgap="18.0" vgap="14.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0" />
                <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="65.0" />
                <RowConstraints minHeight="65.0" />
                <RowConstraints minHeight="65.0" />
                <RowConstraints minHeight="65.0" />
                <RowConstraints minHeight="65.0" />
            </rowConstraints>
            <children>

                <!-- Họ tên -->
                <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <children>
                        <Label text="Họ và tên *"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                        <TextField fx:id="txtFullName" promptText="Nguyễn Văn A"
                                   style="-fx-background-color: white; -fx-border-color: #cbd5e1;
                                          -fx-border-radius: 8; -fx-background-radius: 8;
                                          -fx-padding: 0 12; -fx-pref-height: 42px; -fx-font-size: 14px;" />
                    </children>
                </VBox>

                <!-- Username -->
                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <children>
                        <Label text="Tên đăng nhập *"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                        <TextField fx:id="txtUsername" promptText="nhanvien01"
                                   style="-fx-background-color: white; -fx-border-color: #cbd5e1;
                                          -fx-border-radius: 8; -fx-background-radius: 8;
                                          -fx-padding: 0 12; -fx-pref-height: 42px; -fx-font-size: 14px;" />
                    </children>
                </VBox>

                <!-- Mật khẩu -->
                <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <children>
                        <Label text="Mật khẩu * (≥ 8 ký tự)"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                        <PasswordField fx:id="txtPassword" promptText="••••••••"
                                       style="-fx-background-color: white; -fx-border-color: #cbd5e1;
                                              -fx-border-radius: 8; -fx-background-radius: 8;
                                              -fx-padding: 0 12; -fx-pref-height: 42px; -fx-font-size: 14px;" />
                    </children>
                </VBox>

                <!-- Xác nhận mật khẩu -->
                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <children>
                        <Label text="Xác nhận mật khẩu *"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                        <PasswordField fx:id="txtConfirmPassword" promptText="••••••••"
                                       style="-fx-background-color: white; -fx-border-color: #cbd5e1;
                                              -fx-border-radius: 8; -fx-background-radius: 8;
                                              -fx-padding: 0 12; -fx-pref-height: 42px; -fx-font-size: 14px;" />
                    </children>
                </VBox>

                <!-- CCCD -->
                <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <children>
                        <Label text="Số CCCD *"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                        <TextField fx:id="txtCccd" promptText="0462xxxxxxxx"
                                   style="-fx-background-color: white; -fx-border-color: #cbd5e1;
                                          -fx-border-radius: 8; -fx-background-radius: 8;
                                          -fx-padding: 0 12; -fx-pref-height: 42px; -fx-font-size: 14px;" />
                    </children>
                </VBox>

                <!-- Số điện thoại -->
                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <children>
                        <Label text="Số điện thoại"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                        <TextField fx:id="txtPhone" promptText="0905xxxxxx"
                                   style="-fx-background-color: white; -fx-border-color: #cbd5e1;
                                          -fx-border-radius: 8; -fx-background-radius: 8;
                                          -fx-padding: 0 12; -fx-pref-height: 42px; -fx-font-size: 14px;" />
                    </children>
                </VBox>

                <!-- Email -->
                <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="3">
                    <children>
                        <Label text="Email"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                        <TextField fx:id="txtEmail" promptText="example@gmail.com"
                                   style="-fx-background-color: white; -fx-border-color: #cbd5e1;
                                          -fx-border-radius: 8; -fx-background-radius: 8;
                                          -fx-padding: 0 12; -fx-pref-height: 42px; -fx-font-size: 14px;" />
                    </children>
                </VBox>

                <!-- Ngày sinh -->
                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <children>
                        <Label text="Ngày sinh (dd/MM/yyyy)"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                        <TextField fx:id="txtBirthDate" promptText="15/05/2000"
                                   style="-fx-background-color: white; -fx-border-color: #cbd5e1;
                                          -fx-border-radius: 8; -fx-background-radius: 8;
                                          -fx-padding: 0 12; -fx-pref-height: 42px; -fx-font-size: 14px;" />
                    </children>
                </VBox>

                <!-- Vai trò -->
                <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="4">
                    <children>
                        <Label text="Vai trò *"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                        <ComboBox fx:id="cbRole" maxWidth="Infinity"
                                  style="-fx-background-color: white; -fx-border-color: #cbd5e1;
                                         -fx-border-radius: 8; -fx-background-radius: 8;
                                         -fx-pref-height: 42px; -fx-font-size: 14px;" />
                    </children>
                </VBox>

                <!-- Giới tính -->
                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
                    <children>
                        <Label text="Giới tính"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                        <ComboBox fx:id="cbGender" maxWidth="Infinity"
                                  style="-fx-background-color: white; -fx-border-color: #cbd5e1;
                                         -fx-border-radius: 8; -fx-background-radius: 8;
                                         -fx-pref-height: 42px; -fx-font-size: 14px;" />
                    </children>
                </VBox>

            </children>
        </GridPane>

        <!-- Địa chỉ (full width) -->
        <VBox spacing="5.0">
            <children>
                <Label text="Địa chỉ"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                <TextField fx:id="txtAddress" promptText="Số nhà, đường, phường/xã..."
                           style="-fx-background-color: white; -fx-border-color: #cbd5e1;
                                  -fx-border-radius: 8; -fx-background-radius: 8;
                                  -fx-padding: 0 12; -fx-pref-height: 42px; -fx-font-size: 14px;" />
            </children>
        </VBox>

        <!-- Toast message -->
        <Label fx:id="lblMsg" text="" visible="false"
               style="-fx-font-size: 13px; -fx-font-weight: bold;" />

        <Separator />

        <!-- BUTTONS -->
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleClose"
                        prefHeight="42.0" prefWidth="100.0"
                        style="-fx-background-color: #fff1f2; -fx-text-fill: #e11d48;
                               -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;"
                        text="Hủy bỏ" />
                <Button fx:id="btnSave" mnemonicParsing="false" onAction="#handleSave"
                        prefHeight="42.0" prefWidth="180.0"
                        style="-fx-background-color: linear-gradient(to right, #478dff, #146dff);
                               -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-background-radius: 10; -fx-cursor: hand;
                               -fx-effect: dropshadow(three-pass-box,rgba(71,141,255,0.4),10,0,0,3);"
                        text="💾  Lưu nhân viên">
                    <font><Font name="System Bold" size="13.0" /></font>
                </Button>
            </children>
        </HBox>

    </children>
</VBox>
