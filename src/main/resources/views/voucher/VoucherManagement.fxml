<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="1176.0" prefWidth="1100.0" spacing="20.0" stylesheets="@../../css/voucherview/voucherstyle.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.rentalcar.controller.voucher.VoucherController">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="28.0" />
    </padding>

    <children>
        <!-- ===== HEADER ===== -->
        <HBox alignment="CENTER_LEFT" prefHeight="46.0">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Quản lý Voucher">
                            <font><Font name="System Bold" size="30.0" /></font>
                        </Text>
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;" text="Tạo và quản lý mã giảm giá cho khách hàng" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#handleAddVoucher" prefHeight="46.0" prefWidth="200.0" styleClass="btn-new" text="＋  Tạo voucher mới" textFill="WHITE">
                    <font><Font name="System Bold" size="15.0" /></font>
                </Button>
            </children>
        </HBox>

        <!-- ===== STAT CARDS ===== -->
        <HBox prefHeight="120.0" spacing="20.0">
            <children>
                <AnchorPane prefHeight="120.0" styleClass="card-blue" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="card-title" text="Tổng voucher" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0" />
                        <Label fx:id="lblTotalVouchers" styleClass="card-value" text="--" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="40.0">
                            <font><Font name="System Bold" size="28.0" /></font>
                        </Label>
                        <Label styleClass="card-sub" text="Toàn bộ trong hệ thống" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="85.0" />
                        <Label styleClass="card-icon" text="🎫" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0">
                            <font><Font size="34.0" /></font>
                        </Label>
                    </children>
                </AnchorPane>

                <AnchorPane prefHeight="120.0" styleClass="card-green" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="card-title" text="Đang hoạt động" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0" />
                        <Label fx:id="lblActiveVouchers" styleClass="card-value" text="--" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="40.0">
                            <font><Font name="System Bold" size="28.0" /></font>
                        </Label>
                        <Label styleClass="card-sub" text="Còn hạn và còn lượt dùng" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="85.0" />
                        <Label styleClass="card-icon" text="✅" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0">
                            <font><Font size="34.0" /></font>
                        </Label>
                    </children>
                </AnchorPane>

                <AnchorPane prefHeight="120.0" styleClass="card-yellow" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="card-title" text="Sắp hết hạn" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0" />
                        <Label fx:id="lblExpiringVouchers" styleClass="card-value" text="--" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="40.0">
                            <font><Font name="System Bold" size="28.0" /></font>
                        </Label>
                        <Label styleClass="card-sub" text="Hết hạn trong 7 ngày tới" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="85.0" />
                        <Label styleClass="card-icon" text="⚠️" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0">
                            <font><Font size="34.0" /></font>
                        </Label>
                    </children>
                </AnchorPane>

                <AnchorPane prefHeight="120.0" styleClass="card-red" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="card-title" text="Đã hết hạn / Tắt" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0" />
                        <Label fx:id="lblExpiredVouchers" styleClass="card-value" text="--" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="40.0">
                            <font><Font name="System Bold" size="28.0" /></font>
                        </Label>
                        <Label styleClass="card-sub" text="Không thể sử dụng" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="85.0" />
                        <Label styleClass="card-icon" text="❌" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0">
                            <font><Font size="34.0" /></font>
                        </Label>
                    </children>
                </AnchorPane>
            </children>
        </HBox>

        <!-- ===== SEARCH & FILTER ===== -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <TextField fx:id="txtSearch" prefHeight="42.0" prefWidth="280.0" promptText="🔍  Tìm mã voucher, mô tả..." styleClass="search-field">
                    <font><Font size="14.0" /></font>
                </TextField>
                <ComboBox fx:id="cbTypeFilter" prefHeight="42.0" prefWidth="160.0" styleClass="combo-filter" />
                <ComboBox fx:id="cbStatusFilter" prefHeight="42.0" prefWidth="160.0" styleClass="combo-filter" />
                <Button mnemonicParsing="false" onAction="#handleSearch" prefHeight="42.0" prefWidth="100.0" styleClass="btn-search" text="Tìm kiếm">
                    <font><Font name="System Bold" size="13.0" /></font>
                </Button>
                <Button mnemonicParsing="false" onAction="#handleReload" prefHeight="42.0" prefWidth="90.0" styleClass="btn-reload" text="Làm mới">
                    <font><Font name="System Bold" size="13.0" /></font>
                </Button>
            </children>
        </HBox>

        <!-- ===== TABLE ===== -->
        <VBox prefHeight="700.0" spacing="0.0" styleClass="table_container" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 12 0;">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #1e293b;" text="Danh sách voucher" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblCount" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;                                       -fx-background-color: #f1f5f9; -fx-padding: 4 12;                                       -fx-background-radius: 12;" text="0 voucher" />
                    </children>
                </HBox>

                <TableView fx:id="tableVouchers" prefHeight="640.0" prefWidth="1060.0" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colCode" prefWidth="150.0" text="MÃ VOUCHER" />
                        <TableColumn fx:id="colDesc" prefWidth="200.0" text="MÔ TẢ" />
                        <TableColumn fx:id="colType" prefWidth="120.0" text="LOẠI GIẢM" />
                        <TableColumn fx:id="colValue" prefWidth="130.0" text="GIÁ TRỊ" />
                        <TableColumn fx:id="colUsage" prefWidth="130.0" text="ĐÃ DÙNG / GH" />
                        <TableColumn fx:id="colDate" prefWidth="160.0" text="THỜI HẠN" />
                        <TableColumn fx:id="colStatus" prefWidth="110.0" text="TRẠNG THÁI" />
                        <TableColumn fx:id="colAction" prefWidth="120.0" text="THAO TÁC" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
