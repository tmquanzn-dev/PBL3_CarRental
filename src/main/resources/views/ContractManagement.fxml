<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="1176.0" prefWidth="1100.0" spacing="20.0" stylesheets="@../css/contractview/contractstyle.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.rentalcar.controller.contract.ContractManagementController">

   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="28.0" />
   </padding>

   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="46.0">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Quản lý hợp đồng">
                     <font><Font name="System Bold" size="30.0" /></font>
                  </Text>
                  <Label fx:id="lblSubtitle" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;" text="Danh sách toàn bộ hợp đồng thuê xe" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#showCreateContractModal" prefHeight="46.0" prefWidth="195.0" styleClass="btn-new" text="＋  Tạo hợp đồng mới" textFill="WHITE">
               <font><Font name="System Bold" size="15.0" /></font>
            </Button>
         </children>
      </HBox>

      <HBox prefHeight="120.0" prefWidth="1040.0" spacing="24.0">
         <children>
            <AnchorPane prefHeight="120.0" styleClass="card-blue" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="card-title" text="Tổng hợp đồng" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0" />
                  <Label fx:id="lblTotalContracts" styleClass="card-value" text="--" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="40.0">
                     <font><Font name="System Bold" size="28.0" /></font>
                  </Label>
                  <Label styleClass="card-sub" text="Tổng cộng trong hệ thống" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="85.0" />
                  <Label styleClass="card-icon" text="📋" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0">
                     <font><Font size="34.0" /></font>
                  </Label>
               </children>
            </AnchorPane>

            <AnchorPane prefHeight="120.0" styleClass="card-green" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="card-title" text="Đang thuê" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0" />
                  <Label fx:id="lblActiveContracts" styleClass="card-value" text="--" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="40.0">
                     <font><Font name="System Bold" size="28.0" /></font>
                  </Label>
                  <Label styleClass="card-sub" text="Hợp đồng đang hoạt động" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="85.0" />
                  <Label styleClass="card-icon" text="🏍" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0">
                     <font><Font size="34.0" /></font>
                  </Label>
               </children>
            </AnchorPane>

            <AnchorPane prefHeight="120.0" styleClass="card-yellow" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="card-title" text="Quá hạn" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0" />
                  <Label fx:id="lblOverdueContracts" styleClass="card-value" text="--" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="40.0">
                     <font><Font name="System Bold" size="28.0" /></font>
                  </Label>
                  <Label styleClass="card-sub" text="Chưa trả xe đúng hạn" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="85.0" />
                  <Label styleClass="card-icon" text="⏰" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0">
                     <font><Font size="34.0" /></font>
                  </Label>
               </children>
            </AnchorPane>

            <AnchorPane prefHeight="120.0" styleClass="card-red" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="card-title" text="Doanh thu tháng này" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0" />
                  <Label fx:id="lblMonthlyRevenue" styleClass="card-value" text="--" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="40.0">
                     <font><Font name="System Bold" size="22.0" /></font>
                  </Label>
                  <Label styleClass="card-sub" text="Tổng hợp đồng hoàn thành" AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="85.0" />
                  <Label styleClass="card-icon" text="💰" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0">
                     <font><Font size="34.0" /></font>
                  </Label>
               </children>
            </AnchorPane>
         </children>
      </HBox>

      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>

            <TextField fx:id="txtSearch" prefHeight="42.0" prefWidth="280.0" promptText="🔍  Tìm mã HĐ, khách hàng..." styleClass="search-field">
               <font><Font size="14.0" /></font>
            </TextField>
            <ComboBox fx:id="cbStatusFilter" prefHeight="42.0" prefWidth="180.0" styleClass="combo-filter" />

            <Button fx:id="btnReload" mnemonicParsing="false" onAction="#handleReload" prefHeight="42.0" prefWidth="90.0" styleClass="btn-reload" text="Làm mới">
               <font><Font name="System Bold" size="13.0" /></font>
            </Button>

            <Button fx:id="btnSearch" mnemonicParsing="false" onAction="#handleSearch" prefHeight="42.0" prefWidth="100.0" styleClass="btn-search" text="Tìm kiếm">
               <font><Font name="System Bold" size="13.0" /></font>
            </Button>
         </children>
      </HBox>

      <VBox prefHeight="700.0" spacing="0.0" styleClass="table_container" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 12 0;">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #1e293b;" text="Danh sách hợp đồng" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="lblCount" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px; -fx-background-color: #f1f5f9; -fx-padding: 4 12; -fx-background-radius: 12;" text="0 hợp đồng" />
               </children>
            </HBox>

            <TableView fx:id="tableContracts" prefHeight="640.0" prefWidth="1060.0" VBox.vgrow="ALWAYS">
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <columns>
                  <TableColumn fx:id="colCode" prefWidth="140.0" text="MÃ HỢP ĐỒNG" />
                  <TableColumn fx:id="colCustomer" prefWidth="210.0" text="KHÁCH HÀNG" />
                  <TableColumn fx:id="colVehicle" prefWidth="170.0" text="XE THUÊ" />
                  <TableColumn fx:id="colPeriod" prefWidth="200.0" text="THỜI GIAN THUÊ" />
                  <TableColumn fx:id="colStatus" prefWidth="130.0" text="TRẠNG THÁI" />
                  <TableColumn fx:id="colPayment" prefWidth="130.0" text="THANH TOÁN" />
                  <TableColumn fx:id="colTotal" prefWidth="130.0" text="TỔNG TIỀN" />
                  <TableColumn fx:id="colAction" prefWidth="130.0" text="THAO TÁC" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
