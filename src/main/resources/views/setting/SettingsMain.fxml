                        <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;" text="VehicleRent Pro" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;" text="Phiên bản 1.0.0" />
                    </children>
                </VBox>
            </children>
        </VBox>

        <StackPane HBox.hgrow="ALWAYS">
            <children>
                <fx:include fx:id="panelProfile" source="panels/ProfilePanel.fxml" visible="true" />
                <fx:include fx:id="panelSecurity" source="panels/SecurityPanel.fxml" visible="false" />
                <fx:include fx:id="panelGeneral" source="panels/GeneralPanel.fxml" visible="false" />
                <fx:include fx:id="panelPricing" source="panels/PricingPanel.fxml" visible="false" />
                <fx:include fx:id="panelNotification" source="panels/NotificationPanel.fxml" visible="false" />
                <fx:include fx:id="panelDatabase" source="panels/DatabasePanel.fxml" visible="false" />
                <fx:include fx:id="panelAbout" source="panels/AboutPanel.fxml" visible="false" />
