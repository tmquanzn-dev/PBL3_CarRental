<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fx:id="panelAbout" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.rentalcar.controller.settings.AboutPanelController">
    <content>
        <VBox spacing="20.0" styleClass="settings-content">
            <padding><Insets bottom="30.0" left="30.0" right="30.0" top="28.0" /></padding>
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="settings-section-title" text="Về hệ thống" />
                        <Label styleClass="settings-section-desc" text="Thông tin phiên bản và giấy phép ứng dụng" />
                    </children>
                </VBox>
                <Separator />
                <VBox alignment="CENTER" spacing="16.0" style="-fx-background-color: linear-gradient(to bottom right, #eff6ff, #f0f9ff); -fx-background-radius: 16; -fx-padding: 36;">
                    <children>
                        <Label style="-fx-font-size: 56px;" text="🏍️" />
                        <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="VehicleRent Pro" />
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #64748b;" text="Hệ thống quản lý cho thuê xe máy chuyên nghiệp" wrapText="true" />
                        <HBox alignment="CENTER" spacing="12.0">
                            <children>
                                <Label styleClass="badge-blue" text="Phiên bản 1.0.0" />
                                <Label styleClass="badge-green" text="JavaFX 21" />
                                <Label styleClass="badge-yellow" text="MySQL 8.0" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <VBox spacing="10.0" styleClass="setting-group-card">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                    <children>
                        <Label styleClass="setting-group-title" text="📋  Thông tin hệ thống" />
                        <HBox spacing="40.0" styleClass="info-card">
                            <children>
                                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox spacing="15.0">
                                            <children>
                                                <Label style="-fx-min-width: 140;" styleClass="info-card-label" text="Java Version:" />
                                                <Label fx:id="lblJavaVersion" styleClass="info-card-value" text="Đang tải..." />
                                            </children>
                                        </HBox>
                                        <HBox spacing="15.0">
                                            <children>
                                                <Label style="-fx-min-width: 140;" styleClass="info-card-label" text="JavaFX Version:" />
                                                <Label styleClass="info-card-value" text="21.0.6" />
                                            </children>
                                        </HBox>
                                        <HBox spacing="15.0">
                                            <children>
                                                <Label style="-fx-min-width: 140;" styleClass="info-card-label" text="Hệ điều hành:" />
                                                <Label fx:id="lblOS" styleClass="info-card-value" text="Đang tải..." />
                                            </children>
                                        </HBox>
                                        <HBox spacing="15.0">
                                            <children>
                                                <Label style="-fx-min-width: 140;" styleClass="info-card-label" text="Database:" />
                                                <Label fx:id="lblDbStatus" styleClass="info-card-value" text="Đang kiểm tra..." />
                                            </children>
                                        </HBox>
                                        <HBox spacing="15.0">
                                            <children>
                                                <Label style="-fx-min-width: 140;" styleClass="info-card-label" text="Phát triển bởi:" />
                                                <Label styleClass="info-card-value" text="Nhóm PBL3 - DUT" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>