<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="460.0" spacing="16.0"
      style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #cbd5e1; -fx-border-radius: 12; -fx-border-width: 1;"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.rentalcar.controller.contract.EarlyReturnModalController">

    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
    </padding>

    <children>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <Label text="⚡" style="-fx-font-size: 24px;" />
                <VBox spacing="2.0">
                    <children>
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Trả xe trước thời hạn" />
                        <Label fx:id="lblTimeUnused" style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="Thời gian hoàn thành sớm: --" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <Separator />

        <VBox spacing="12.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-padding: 16;">
            <children>
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="📊 BÓC TÁCH CHI PHÍ LUẬT MỚI:" />

                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 13px;" text="Tiền thuê thực tế đã sử dụng:" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblActualUsedPrice" style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 13px;" text="0 đ" />
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 13px;" text="Phí huỷ ngang (30% tiền đã đi):" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblPenaltyFee" style="-fx-font-weight: bold; -fx-text-fill: #e11d48; -fx-font-size: 13px;" text="0 đ" />
                    </children>
                </HBox>

                <Separator style="-fx-padding: 4 0;" />

                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Tiền thuê cơ bản điều chỉnh:" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblNewBasePrice" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2563eb;" text="0 đ" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <Label style="-fx-text-fill: #475569; -fx-font-size: 12px;" text="⚠️ Hệ thống sẽ tự động đối chiếu số tiền này với các khoản đặt cọc và tiền đã thanh toán trước đó để chốt hóa đơn thu chi." wrapText="true" />

        <HBox alignment="CENTER_RIGHT" spacing="12.0" style="-fx-padding: 8 0 0 0;">
            <children>
                <Button mnemonicParsing="false" onAction="#handleCancel" prefHeight="38.0" prefWidth="90.0"
                        style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;" text="Hủy bỏ" />
                <Button mnemonicParsing="false" onAction="#handleConfirm" prefHeight="38.0" prefWidth="160.0"
                        style="-fx-background-color: linear-gradient(to right, #3b82f6, #1d4ed8); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="✅ Tiếp tục chốt" />
            </children>
        </HBox>
    </children>
</VBox>