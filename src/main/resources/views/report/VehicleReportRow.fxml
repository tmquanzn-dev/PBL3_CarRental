<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<HBox fx:id="rowContainer" alignment="CENTER_LEFT" minHeight="48.0" prefHeight="48.0" prefWidth="500.0" style="-fx-border-color: transparent transparent #f1f5f9 transparent; -fx-border-width: 1;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://fxml.com/fx/1" fx:controller="com.example.rentalcar.controller.report.VehicleRowController">
    <children>
        <Label fx:id="lblRank" alignment="CENTER" prefWidth="40.0" text="1" textAlignment="CENTER">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <Label fx:id="lblVehicleName" maxWidth="1.7976931348623157E308" text="Honda Vision 2023" HBox.hgrow="ALWAYS">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
            <HBox.margin>
                <Insets left="5.0" />
            </HBox.margin>
        </Label>

        <Label fx:id="lblPlateNumber" alignment="CENTER" prefWidth="95.0" style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 6;" text="43C1-999.99">
            <font>
                <Font name="System Bold" size="11.0" />
            </font>
            <padding>
                <Insets bottom="3.0" left="7.0" right="7.0" top="3.0" />
            </padding>
            <HBox.margin>
                <Insets right="10.0" />
            </HBox.margin>
        </Label>

        <Label fx:id="lblRentalCount" alignment="CENTER" prefWidth="55.0" style="-fx-text-fill: #2563eb;" text="15 lượt">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
            <HBox.margin>
                <Insets right="10.0" />
            </HBox.margin>
        </Label>

        <Label fx:id="lblRevenue" alignment="CENTER_RIGHT" prefWidth="115.0" style="-fx-text-fill: #dc2626;" text="12.500.000 đ">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
            <HBox.margin>
                <Insets right="10.0" />
            </HBox.margin>
        </Label>
    </children>
    <padding>
        <Insets left="10.0" right="10.0" />
    </padding>
</HBox>