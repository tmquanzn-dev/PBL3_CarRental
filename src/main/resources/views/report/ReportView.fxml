<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="850.0" prefWidth="1150.0" spacing="25.0" styleClass="main-bg"
      stylesheets="@../../css/reportview/reportstyle.css" xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.rentalcar.controller.report.ReportController">
    <padding>
        <Insets bottom="30.0" left="35.0" right="35.0" top="30.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="100.0" spacing="20.0" styleClass="filter-box" VBox.vgrow="NEVER">
            <children>
                <VBox alignment="CENTER_LEFT" spacing="5.0">
                    <Label styleClass="header-title" text="Thống kê doanh thu" />
                    <Label styleClass="header-subtitle" text="Dữ liệu kinh doanh chi tiết theo thời gian" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label text="Lọc theo:" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
                <ComboBox fx:id="cbTimeFilter" prefHeight="45.0" prefWidth="150.0" promptText="Chọn mốc" />
                <DatePicker fx:id="dpDate" prefHeight="45.0" prefWidth="180.0" />
                <Button onAction="#handleGenerateReport" prefHeight="45.0" prefWidth="130.0"
                        styleClass="btn-primary" text="Xem báo cáo"
                        style="-fx-background-color: #478dff; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" />
            </children>
            <padding>
                <Insets left="30.0" right="30.0" />
            </padding>
        </HBox>

        <HBox spacing="30.0" VBox.vgrow="NEVER">
            <children>
                <VBox styleClass="kpi-card, card-revenue" HBox.hgrow="ALWAYS" spacing="10.0">
                    <Label styleClass="kpi-title" text="DOANH THU" />
                    <Label fx:id="lblTotalRevenue" styleClass="kpi-value" text="0 đ" />
                </VBox>
                <VBox styleClass="kpi-card, card-rentals" HBox.hgrow="ALWAYS" spacing="10.0">
                    <Label styleClass="kpi-title" text="LƯỢT THUÊ" />
                    <Label fx:id="lblTotalRentals" styleClass="kpi-value" text="0" />
                </VBox>
                <VBox styleClass="kpi-card, card-customers" HBox.hgrow="ALWAYS" spacing="10.0">
                    <Label styleClass="kpi-title" text="KHÁCH MỚI" />
                    <Label fx:id="lblNewCustomers" styleClass="kpi-value" text="0" />
                </VBox>
            </children>
        </HBox>

        <VBox styleClass="chart-container" VBox.vgrow="ALWAYS">
            <children>
                <Label text="Phân tích biểu đồ doanh thu" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                <BarChart fx:id="revenueChart" animated="false" legendVisible="false" VBox.vgrow="ALWAYS" minHeight="450.0">
                    <xAxis>
                        <CategoryAxis side="BOTTOM" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis side="LEFT" />
                    </yAxis>
                </BarChart>
            </children>
        </VBox>
    </children>
</VBox>