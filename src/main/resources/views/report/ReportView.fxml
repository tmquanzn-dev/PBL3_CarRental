<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER"
            style="-fx-background-color: #f4f7f6; -fx-background: #f4f7f6;"
            stylesheets="@../../css/reportview/reportstyle.css"
            xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.rentalcar.controller.report.ReportController">
    <content>
        <VBox spacing="22.0" style="-fx-background-color: #f4f7f6; -fx-min-width: 1040px;">
            <padding>
                <Insets bottom="40.0" left="32.0" right="32.0" top="28.0" />
            </padding>
            <children>

                <!-- ============================================================
                     HEADER
                ============================================================ -->
                <HBox alignment="CENTER_LEFT" spacing="14.0">
                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Báo cáo &amp; Thống kê">
                                    <font><Font name="System Bold" size="30.0" /></font>
                                </Text>
                                <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"
                                       text="Tổng hợp hiệu suất kinh doanh theo năm" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <!-- Chọn năm -->
                        <HBox alignment="CENTER" spacing="4.0"
                              style="-fx-background-color: white; -fx-background-radius: 12;
                                     -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.07),10,0,0,3);
                                     -fx-padding: 5 10;">
                            <children>
                                <Button fx:id="btnPrevYear" mnemonicParsing="false" onAction="#handlePrevYear"
                                        style="-fx-background-color: transparent; -fx-text-fill: #64748b;
                                               -fx-font-size: 18px; -fx-cursor: hand; -fx-padding: 2 8;" text="‹" />
                                <Label fx:id="lblYear"
                                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;
                                              -fx-min-width: 54px; -fx-alignment: center;" text="2026" />
                                <Button fx:id="btnNextYear" mnemonicParsing="false" onAction="#handleNextYear"
                                        style="-fx-background-color: transparent; -fx-text-fill: #64748b;
                                               -fx-font-size: 18px; -fx-cursor: hand; -fx-padding: 2 8;" text="›" />
                            </children>
                        </HBox>
                        <Button mnemonicParsing="false" onAction="#handleExport"
                                style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569;
                                       -fx-background-radius: 10; -fx-font-weight: bold;
                                       -fx-cursor: hand; -fx-padding: 10 18; -fx-font-size: 13px;"
                                text="⬇  Xuất báo cáo" />
                    </children>
                </HBox>

                <!-- ============================================================
                     4 KPI CARDS — inline style để đảm bảo hiển thị màu
                ============================================================ -->
                <GridPane hgap="18.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0" />
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0" />
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0" />
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints prefHeight="128.0" />
                    </rowConstraints>
                    <children>

                        <!-- Card 1: Doanh thu — Xanh dương -->
                        <AnchorPane prefHeight="128.0"
                                    style="-fx-background-color: linear-gradient(to bottom right, #478dff, #146dff);
                                           -fx-background-radius: 14;
                                           -fx-effect: dropshadow(three-pass-box,rgba(71,141,255,0.35),14,0,0,6);"
                                    GridPane.columnIndex="0">
                            <children>
                                <Label style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 13px;"
                                       text="Doanh thu năm"
                                       AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0" />
                                <Label fx:id="lblYearRevenue"
                                       style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"
                                       text="--"
                                       AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="40.0">
                                    <font><Font name="System Bold" size="22.0" /></font>
                                </Label>
                                <Label fx:id="lblRevenueGrowth"
                                       style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 12px;"
                                       text="--"
                                       AnchorPane.leftAnchor="18.0" AnchorPane.bottomAnchor="12.0"
                                       AnchorPane.rightAnchor="12.0" wrapText="true" />
                                <Label style="-fx-text-fill: white; -fx-font-size: 34px; -fx-opacity: 0.18;"
                                       text="💰"
                                       AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0" />
                            </children>
                        </AnchorPane>

                        <!-- Card 2: Hợp đồng — Xanh lá -->
                        <AnchorPane prefHeight="128.0"
                                    style="-fx-background-color: linear-gradient(to bottom right, #34d399, #10b981);
                                           -fx-background-radius: 14;
                                           -fx-effect: dropshadow(three-pass-box,rgba(16,185,129,0.35),14,0,0,6);"
                                    GridPane.columnIndex="1">
                            <children>
                                <Label style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 13px;"
                                       text="Hợp đồng hoàn thành"
                                       AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0" />
                                <Label fx:id="lblYearContracts"
                                       style="-fx-text-fill: white; -fx-font-size: 30px; -fx-font-weight: bold;"
                                       text="--"
                                       AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="38.0">
                                    <font><Font name="System Bold" size="30.0" /></font>
                                </Label>
                                <Label fx:id="lblContractSub"
                                       style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 12px;"
                                       text="đã hoàn thành trong năm"
                                       AnchorPane.leftAnchor="18.0" AnchorPane.bottomAnchor="12.0" />
                                <Label style="-fx-text-fill: white; -fx-font-size: 34px; -fx-opacity: 0.18;"
                                       text="📋"
                                       AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0" />
                            </children>
                        </AnchorPane>

                        <!-- Card 3: Khách hàng — Tím -->
                        <AnchorPane prefHeight="128.0"
                                    style="-fx-background-color: linear-gradient(to bottom right, #a78bfa, #7c3aed);
                                           -fx-background-radius: 14;
                                           -fx-effect: dropshadow(three-pass-box,rgba(124,58,237,0.35),14,0,0,6);"
                                    GridPane.columnIndex="2">
                            <children>
                                <Label style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 13px;"
                                       text="Khách hàng đã thuê"
                                       AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0" />
                                <Label fx:id="lblTotalCustomers"
                                       style="-fx-text-fill: white; -fx-font-size: 30px; -fx-font-weight: bold;"
                                       text="--"
                                       AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="38.0">
                                    <font><Font name="System Bold" size="30.0" /></font>
                                </Label>
                                <Label style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 12px;"
                                       text="khách phát sinh đơn thuê"
                                       AnchorPane.leftAnchor="18.0" AnchorPane.bottomAnchor="12.0" />
                                <Label style="-fx-text-fill: white; -fx-font-size: 34px; -fx-opacity: 0.18;"
                                       text="👥"
                                       AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0" />
                            </children>
                        </AnchorPane>

                        <!-- Card 4: DT trung bình — Cam -->
                        <AnchorPane prefHeight="128.0"
                                    style="-fx-background-color: linear-gradient(to bottom right, #fb923c, #f97316);
                                           -fx-background-radius: 14;
                                           -fx-effect: dropshadow(three-pass-box,rgba(249,115,22,0.35),14,0,0,6);"
                                    GridPane.columnIndex="3">
                            <children>
                                <Label style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 13px;"
                                       text="DT trung bình / tháng"
                                       AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0" />
                                <Label fx:id="lblAvgMonthly"
                                       style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"
                                       text="--"
                                       AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="40.0">
                                    <font><Font name="System Bold" size="22.0" /></font>
                                </Label>
                                <Label style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 12px;"
                                       text="tính trên 12 tháng"
                                       AnchorPane.leftAnchor="18.0" AnchorPane.bottomAnchor="12.0" />
                                <Label style="-fx-text-fill: white; -fx-font-size: 34px; -fx-opacity: 0.18;"
                                       text="📈"
                                       AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0" />
                            </children>
                        </AnchorPane>

                    </children>
                </GridPane>

                <!-- ============================================================
                     ROW 2: BAR CHART + PIE CHART
                ============================================================ -->
                <HBox prefHeight="380.0" spacing="18.0">
                    <children>

                        <!-- BAR CHART -->
                        <VBox spacing="12.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 14;
                                     -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.05),10,0,0,4);">
                            <padding>
                                <Insets bottom="20.0" left="22.0" right="22.0" top="18.0" />
                            </padding>
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <VBox spacing="3.0">
                                            <children>
                                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold;
                                                              -fx-text-fill: #1e293b;"
                                                       text="Doanh thu theo tháng" />
                                                <Label fx:id="lblChartSubtitle"
                                                       style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"
                                                       text="Đơn vị: triệu đồng" />
                                            </children>
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblPeakMonth"
                                               style="-fx-background-color: #eff6ff; -fx-text-fill: #1d4ed8;
                                                      -fx-background-radius: 8; -fx-padding: 5 12;
                                                      -fx-font-size: 12px; -fx-font-weight: bold;"
                                               text="" visible="false" />
                                    </children>
                                </HBox>
                                <BarChart fx:id="barChartRevenue"
                                          animated="false" barGap="4" categoryGap="14"
                                          legendVisible="false" prefHeight="300.0"
                                          VBox.vgrow="ALWAYS">
                                    <xAxis>
                                        <CategoryAxis fx:id="xAxis" label="" side="BOTTOM" />
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis fx:id="yAxis" label="" side="LEFT" />
                                    </yAxis>
                                </BarChart>
                            </children>
                        </VBox>

                        <!-- PIE CHART -->
                        <VBox prefWidth="310.0" spacing="12.0"
                              style="-fx-background-color: white; -fx-background-radius: 14;
                                     -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.05),10,0,0,4);">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="18.0" />
                            </padding>
                            <children>
                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"
                                       text="Phân bổ hợp đồng" />
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"
                                       text="Theo trạng thái trong năm" />
                                <PieChart fx:id="pieChartStatus"
                                          animated="false" clockwise="true"
                                          labelsVisible="true" legendSide="BOTTOM"
                                          legendVisible="true" prefHeight="290.0"
                                          VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>

                    </children>
                </HBox>

                <!-- ============================================================
                     ROW 3: TOP VEHICLES + TOP STAFF
                ============================================================ -->
                <HBox prefHeight="330.0" spacing="18.0">
                    <children>

                        <!-- TOP XE -->
                        <VBox spacing="14.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 14;
                                     -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.05),10,0,0,4);">
                            <padding>
                                <Insets bottom="18.0" left="22.0" right="22.0" top="18.0" />
                            </padding>
                            <children>
                                <VBox spacing="3.0">
                                    <children>
                                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"
                                               text="🏍  Top xe cho thuê nhiều nhất" />
                                        <Label style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"
                                               text="Xếp hạng theo số lượt thuê" />
                                    </children>
                                </VBox>
                                <Separator style="-fx-background-color: #f1f5f9;" />
                                <TableView fx:id="tableTopVehicles" prefHeight="240.0"
                                           styleClass="rank-table" VBox.vgrow="ALWAYS">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="colVRank"  maxWidth="60.0" minWidth="60.0" text="#" />
                                        <TableColumn fx:id="colVName"  prefWidth="180.0" text="Xe" />
                                        <TableColumn fx:id="colVPlate" prefWidth="110.0" text="Biển số" />
                                        <TableColumn fx:id="colVCount" prefWidth="95.0"  text="Lượt thuê" />
                                        <TableColumn fx:id="colVRevenue" prefWidth="150.0" text="Doanh thu" />
                                    </columns>
                                    <placeholder>
                                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size:13px;"
                                               text="Chưa có dữ liệu cho năm này" />
                                    </placeholder>
                                </TableView>
                            </children>
                        </VBox>

                        <!-- TOP NHÂN VIÊN -->
                        <VBox prefWidth="400.0" spacing="14.0"
                              style="-fx-background-color: white; -fx-background-radius: 14;
                                     -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.05),10,0,0,4);">
                            <padding>
                                <Insets bottom="18.0" left="22.0" right="22.0" top="18.0" />
                            </padding>
                            <children>
                                <VBox spacing="3.0">
                                    <children>
                                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"
                                               text="🏆  Top nhân viên xuất sắc" />
                                        <Label style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"
                                               text="Xếp hạng theo doanh thu tạo ra" />
                                    </children>
                                </VBox>
                                <Separator style="-fx-background-color: #f1f5f9;" />
                                <TableView fx:id="tableTopStaff" prefHeight="240.0"
                                           styleClass="rank-table" VBox.vgrow="ALWAYS">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="colSRank"      maxWidth="60.0" minWidth="60.0" text="#" />
                                        <TableColumn fx:id="colSName"      prefWidth="160.0" text="Nhân viên" />
                                        <TableColumn fx:id="colSContracts" prefWidth="80.0"  text="Số HĐ" />
                                        <TableColumn fx:id="colSRevenue"   prefWidth="140.0" text="Doanh thu" />
                                    </columns>
                                    <placeholder>
                                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size:13px;"
                                               text="Chưa có dữ liệu cho năm này" />
                                    </placeholder>
                                </TableView>
                            </children>
                        </VBox>

                    </children>
                </HBox>

            </children>
        </VBox>
    </content>
</ScrollPane>
