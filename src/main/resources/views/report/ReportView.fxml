<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox
        prefWidth="1100.0"
        spacing="20.0"
        style="-fx-background-color: #f0f4f8;"
        stylesheets="@../../css/reportview/reportstyle.css"
        xmlns="http://javafx.com/javafx/8.0.171"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.rentalcar.controller.report.ReportController">

    <padding>
        <Insets bottom="36.0" left="32.0" right="32.0" top="28.0" />
    </padding>

    <children>

        <!-- ═══════════════════════════════════════════
             HEADER BAR
        ═══════════════════════════════════════════ -->
        <HBox alignment="CENTER_LEFT" spacing="14.0">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Text text="Báo cáo &amp; Thống kê">
                            <font><Font name="System Bold" size="30.0" /></font>
                        </Text>
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 13px;"
                               text="Tổng hợp hiệu suất kinh doanh theo thời gian" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />

                <!-- Bộ lọc tháng -->
                <ComboBox fx:id="cbMonth" prefHeight="40.0" prefWidth="120.0"
                          style="-fx-background-color: white; -fx-border-color: #e2e8f0;
                                 -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px;" />

                <!-- Chọn năm -->
                <HBox alignment="CENTER" spacing="4.0"
                      style="-fx-background-color: white; -fx-background-radius: 10;
                             -fx-border-color: #e2e8f0; -fx-border-radius: 10;
                             -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.05),8,0,0,2);
                             -fx-padding: 4 10;">
                    <children>
                        <Button fx:id="btnPrevYear" mnemonicParsing="false"
                                onAction="#handlePrevYear"
                                style="-fx-background-color: transparent; -fx-text-fill: #64748b;
                                       -fx-font-size: 16px; -fx-cursor: hand; -fx-padding: 2 8;"
                                text="‹" />
                        <Label fx:id="lblYear"
                               style="-fx-font-size: 16px; -fx-font-weight: bold;
                                      -fx-text-fill: #1e293b; -fx-min-width: 54px;
                                      -fx-alignment: center;"
                               text="2026" />
                        <Button fx:id="btnNextYear" mnemonicParsing="false"
                                onAction="#handleNextYear"
                                style="-fx-background-color: transparent; -fx-text-fill: #64748b;
                                       -fx-font-size: 16px; -fx-cursor: hand; -fx-padding: 2 8;"
                                text="›" />
                    </children>
                </HBox>

                <!-- Xuất PDF -->
                <Button fx:id="btnExportPdf" mnemonicParsing="false"
                        onAction="#handleExportPdf"
                        prefHeight="40.0"
                        style="-fx-background-color: #ef4444; -fx-text-fill: white;
                               -fx-background-radius: 10; -fx-font-weight: bold;
                               -fx-cursor: hand; -fx-padding: 8 18; -fx-font-size: 13px;
                               -fx-effect: dropshadow(three-pass-box,rgba(239,68,68,0.3),8,0,0,3);"
                        text="🖨  In báo cáo PDF" />

                <!-- Làm mới -->
                <Button mnemonicParsing="false" onAction="#handleRefresh"
                        prefHeight="40.0"
                        style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569;
                               -fx-background-radius: 10; -fx-font-weight: bold;
                               -fx-cursor: hand; -fx-padding: 8 18; -fx-font-size: 13px;"
                        text="🔄  Làm mới" />
            </children>
        </HBox>

        <!-- ═══════════════════════════════════════════
             4 KPI CARDS
        ═══════════════════════════════════════════ -->
        <GridPane hgap="16.0" prefHeight="125.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0" />
                <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0" />
                <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0" />
                <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="125.0" prefHeight="125.0" />
            </rowConstraints>
            <children>

                <!-- Doanh thu năm -->
                <AnchorPane prefHeight="125.0"
                            style="-fx-background-color: linear-gradient(to bottom right,#3b82f6,#1d4ed8);
                                   -fx-background-radius: 14;
                                   -fx-effect: dropshadow(three-pass-box,rgba(59,130,246,0.4),14,0,0,6);"
                            GridPane.columnIndex="0">
                    <children>
                        <Label style="-fx-text-fill:rgba(255,255,255,0.9);-fx-font-size:13px;"
                               text="Doanh thu năm" AnchorPane.leftAnchor="16.0" AnchorPane.topAnchor="14.0"/>
                        <Label fx:id="lblYearRevenue"
                               style="-fx-text-fill:white;-fx-font-size:22px;-fx-font-weight:bold;"
                               text="--" AnchorPane.leftAnchor="16.0" AnchorPane.topAnchor="40.0">
                            <font><Font name="System Bold" size="22.0"/></font>
                        </Label>
                        <Label fx:id="lblRevenueGrowth"
                               style="-fx-text-fill:rgba(255,255,255,0.82);-fx-font-size:11px;"
                               text="--" wrapText="true"
                               AnchorPane.leftAnchor="16.0" AnchorPane.bottomAnchor="12.0"
                               AnchorPane.rightAnchor="44.0"/>
                        <Label style="-fx-text-fill:white;-fx-font-size:36px;-fx-opacity:0.15;"
                               text="💰" AnchorPane.rightAnchor="8.0" AnchorPane.topAnchor="10.0"/>
                    </children>
                </AnchorPane>

                <!-- Hợp đồng hoàn thành -->
                <AnchorPane prefHeight="125.0"
                            style="-fx-background-color: linear-gradient(to bottom right,#10b981,#059669);
                                   -fx-background-radius: 14;
                                   -fx-effect: dropshadow(three-pass-box,rgba(16,185,129,0.4),14,0,0,6);"
                            GridPane.columnIndex="1">
                    <children>
                        <Label style="-fx-text-fill:rgba(255,255,255,0.9);-fx-font-size:13px;"
                               text="Hợp đồng hoàn thành" AnchorPane.leftAnchor="16.0" AnchorPane.topAnchor="14.0"/>
                        <Label fx:id="lblYearContracts"
                               style="-fx-text-fill:white;-fx-font-size:32px;-fx-font-weight:bold;"
                               text="--" AnchorPane.leftAnchor="16.0" AnchorPane.topAnchor="36.0">
                            <font><Font name="System Bold" size="32.0"/></font>
                        </Label>
                        <Label fx:id="lblContractSub"
                               style="-fx-text-fill:rgba(255,255,255,0.82);-fx-font-size:11px;"
                               text="trong năm" AnchorPane.leftAnchor="16.0" AnchorPane.bottomAnchor="12.0"/>
                        <Label style="-fx-text-fill:white;-fx-font-size:36px;-fx-opacity:0.15;"
                               text="📋" AnchorPane.rightAnchor="8.0" AnchorPane.topAnchor="10.0"/>
                    </children>
                </AnchorPane>

                <!-- Khách hàng -->
                <AnchorPane prefHeight="125.0"
                            style="-fx-background-color: linear-gradient(to bottom right,#8b5cf6,#6d28d9);
                                   -fx-background-radius: 14;
                                   -fx-effect: dropshadow(three-pass-box,rgba(139,92,246,0.4),14,0,0,6);"
                            GridPane.columnIndex="2">
                    <children>
                        <Label style="-fx-text-fill:rgba(255,255,255,0.9);-fx-font-size:13px;"
                               text="Khách hàng đã thuê" AnchorPane.leftAnchor="16.0" AnchorPane.topAnchor="14.0"/>
                        <Label fx:id="lblTotalCustomers"
                               style="-fx-text-fill:white;-fx-font-size:32px;-fx-font-weight:bold;"
                               text="--" AnchorPane.leftAnchor="16.0" AnchorPane.topAnchor="36.0">
                            <font><Font name="System Bold" size="32.0"/></font>
                        </Label>
                        <Label style="-fx-text-fill:rgba(255,255,255,0.82);-fx-font-size:11px;"
                               text="lượt khách phát sinh đơn"
                               AnchorPane.leftAnchor="16.0" AnchorPane.bottomAnchor="12.0"/>
                        <Label style="-fx-text-fill:white;-fx-font-size:36px;-fx-opacity:0.15;"
                               text="👥" AnchorPane.rightAnchor="8.0" AnchorPane.topAnchor="10.0"/>
                    </children>
                </AnchorPane>

                <!-- DT trung bình tháng -->
                <AnchorPane prefHeight="125.0"
                            style="-fx-background-color: linear-gradient(to bottom right,#f97316,#ea580c);
                                   -fx-background-radius: 14;
                                   -fx-effect: dropshadow(three-pass-box,rgba(249,115,22,0.4),14,0,0,6);"
                            GridPane.columnIndex="3">
                    <children>
                        <Label style="-fx-text-fill:rgba(255,255,255,0.9);-fx-font-size:13px;"
                               text="DT trung bình / tháng" AnchorPane.leftAnchor="16.0" AnchorPane.topAnchor="14.0"/>
                        <Label fx:id="lblAvgMonthly"
                               style="-fx-text-fill:white;-fx-font-size:20px;-fx-font-weight:bold;"
                               text="--" AnchorPane.leftAnchor="16.0" AnchorPane.topAnchor="40.0">
                            <font><Font name="System Bold" size="20.0"/></font>
                        </Label>
                        <Label style="-fx-text-fill:rgba(255,255,255,0.82);-fx-font-size:11px;"
                               text="tính trên 12 tháng"
                               AnchorPane.leftAnchor="16.0" AnchorPane.bottomAnchor="12.0"/>
                        <Label style="-fx-text-fill:white;-fx-font-size:36px;-fx-opacity:0.15;"
                               text="📈" AnchorPane.rightAnchor="8.0" AnchorPane.topAnchor="10.0"/>
                    </children>
                </AnchorPane>

            </children>
        </GridPane>

        <!-- ═══════════════════════════════════════════
             ROW 2: BAR CHART + PIE CHART
        ═══════════════════════════════════════════ -->
        <HBox prefHeight="380.0" spacing="16.0">
            <children>

                <!-- BAR CHART doanh thu theo tháng -->
                <VBox prefHeight="380.0"
                      style="-fx-background-color: white; -fx-background-radius: 14;
                             -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.05),12,0,0,4);"
                      HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="16.0" left="20.0" right="20.0" top="16.0"/></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="40.0">
                            <children>
                                <VBox spacing="2.0">
                                    <children>
                                        <Label style="-fx-font-size:15px;-fx-font-weight:bold;-fx-text-fill:#1e293b;"
                                               text="Doanh thu theo tháng"/>
                                        <Label fx:id="lblChartSubtitle"
                                               style="-fx-font-size:11px;-fx-text-fill:#94a3b8;"
                                               text="Đơn vị: triệu đồng"/>
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblPeakMonth"
                                       style="-fx-background-color:#eff6ff;-fx-text-fill:#1d4ed8;
                                              -fx-background-radius:8;-fx-padding:4 10;
                                              -fx-font-size:11px;-fx-font-weight:bold;"
                                       text="" visible="false"/>
                            </children>
                        </HBox>
                        <BarChart fx:id="barChartRevenue"
                                  prefHeight="310.0" animated="false"
                                  barGap="3" categoryGap="12" legendVisible="false"
                                  VBox.vgrow="ALWAYS">
                            <xAxis><CategoryAxis fx:id="xAxis" side="BOTTOM"/></xAxis>
                            <yAxis><NumberAxis fx:id="yAxis" side="LEFT" label="(tr.đ)"/></yAxis>
                        </BarChart>
                    </children>
                </VBox>

                <!-- PIE CHART phân bổ trạng thái -->
                <VBox prefHeight="380.0" prefWidth="290.0"
                      style="-fx-background-color: white; -fx-background-radius: 14;
                             -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.05),12,0,0,4);">
                    <padding><Insets bottom="16.0" left="18.0" right="18.0" top="16.0"/></padding>
                    <children>
                        <Label style="-fx-font-size:15px;-fx-font-weight:bold;-fx-text-fill:#1e293b;"
                               text="Phân bổ hợp đồng"/>
                        <Label style="-fx-font-size:11px;-fx-text-fill:#94a3b8;-fx-padding:0 0 6 0;"
                               text="Theo trạng thái trong năm"/>
                        <PieChart fx:id="pieChartStatus"
                                  prefHeight="310.0" animated="false"
                                  clockwise="true" legendSide="BOTTOM"
                                  legendVisible="true" labelsVisible="true"
                                  VBox.vgrow="ALWAYS"/>
                    </children>
                </VBox>

            </children>
        </HBox>

        <!-- ROW 3: TOP 5 XE + TOP 5 NHÂN VIÊN - dùng VBox, không dùng TableView -->
        <HBox spacing="16.0">
            <children>

                <!-- TOP 5 XE -->
                <VBox style="-fx-background-color:white;-fx-background-radius:14;
                             -fx-effect:dropshadow(three-pass-box,rgba(0,0,0,0.05),12,0,0,4);"
                      HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="16.0" left="18.0" right="18.0" top="16.0"/></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label style="-fx-font-size:15px;-fx-font-weight:bold;-fx-text-fill:#1e293b;"
                                       text="🏍  Top 5 xe thuê nhiều nhất"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblTopVehiclesPeriod"
                                       style="-fx-background-color:#f0fdf4;-fx-text-fill:#16a34a;
                                              -fx-background-radius:8;-fx-padding:3 10;
                                              -fx-font-size:11px;-fx-font-weight:bold;"
                                       text="Tháng này"/>
                            </children>
                        </HBox>
                        <Label style="-fx-font-size:11px;-fx-text-fill:#94a3b8;-fx-padding:2 0 8 0;"
                               text="Xếp hạng theo số lượt thuê"/>
                        <!-- Header -->
                        <HBox style="-fx-background-color:#f8fafc;-fx-background-radius:8;
                                     -fx-padding:8 10;-fx-border-color:#e2e8f0;
                                     -fx-border-radius:8;-fx-border-width:1;">
                            <children>
                                <Label prefWidth="40.0" text="#"
                                       style="-fx-font-size:11px;-fx-font-weight:bold;-fx-text-fill:#64748b;"/>
                                <Label text="Xe" HBox.hgrow="ALWAYS"
                                       style="-fx-font-size:11px;-fx-font-weight:bold;-fx-text-fill:#64748b;"/>
                                <Label prefWidth="95.0" text="Biển số"
                                       style="-fx-font-size:11px;-fx-font-weight:bold;-fx-text-fill:#64748b;"/>
                                <Label prefWidth="55.0" text="Lượt"
                                       style="-fx-font-size:11px;-fx-font-weight:bold;-fx-text-fill:#64748b;"/>
                                <Label prefWidth="115.0" text="Doanh thu"
                                       style="-fx-font-size:11px;-fx-font-weight:bold;-fx-text-fill:#64748b;-fx-alignment:CENTER_RIGHT;"/>
                            </children>
                        </HBox>
                        <!-- Rows được render bằng code -->
                        <VBox fx:id="vboxTopVehicles" spacing="0.0"/>
                        <Label fx:id="lblNoVehicles" text="Chưa có dữ liệu"
                               visible="false" managed="false"
                               style="-fx-text-fill:#94a3b8;-fx-font-size:13px;-fx-padding:16 0;"/>
                    </children>
                </VBox>

                <!-- TOP 5 NHÂN VIÊN -->
                <VBox style="-fx-background-color:white;-fx-background-radius:14;
                             -fx-effect:dropshadow(three-pass-box,rgba(0,0,0,0.05),12,0,0,4);"
                      HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="16.0" left="18.0" right="18.0" top="16.0"/></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label style="-fx-font-size:15px;-fx-font-weight:bold;-fx-text-fill:#1e293b;"
                                       text="🏆  Top 5 nhân viên xuất sắc"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblTopStaffPeriod"
                                       style="-fx-background-color:#fef3c7;-fx-text-fill:#b45309;
                                              -fx-background-radius:8;-fx-padding:3 10;
                                              -fx-font-size:11px;-fx-font-weight:bold;"
                                       text="Tháng này"/>
                            </children>
                        </HBox>
                        <Label style="-fx-font-size:11px;-fx-text-fill:#94a3b8;-fx-padding:2 0 8 0;"
                               text="Xếp hạng theo doanh thu tạo ra"/>
                        <!-- Header -->
                        <HBox style="-fx-background-color:#f8fafc;-fx-background-radius:8;
                                     -fx-padding:8 10;-fx-border-color:#e2e8f0;
                                     -fx-border-radius:8;-fx-border-width:1;">
                            <children>
                                <Label prefWidth="40.0" text="#"
                                       style="-fx-font-size:11px;-fx-font-weight:bold;-fx-text-fill:#64748b;"/>
                                <Label text="Nhân viên" HBox.hgrow="ALWAYS"
                                       style="-fx-font-size:11px;-fx-font-weight:bold;-fx-text-fill:#64748b;"/>
                                <Label prefWidth="65.0" text="Số HĐ"
                                       style="-fx-font-size:11px;-fx-font-weight:bold;-fx-text-fill:#64748b;"/>
                                <Label prefWidth="115.0" text="Doanh thu"
                                       style="-fx-font-size:11px;-fx-font-weight:bold;-fx-text-fill:#64748b;-fx-alignment:CENTER_RIGHT;"/>
                            </children>
                        </HBox>
                        <!-- Rows -->
                        <VBox fx:id="vboxTopStaff" spacing="0.0"/>
                        <Label fx:id="lblNoStaff" text="Chưa có dữ liệu"
                               visible="false" managed="false"
                               style="-fx-text-fill:#94a3b8;-fx-font-size:13px;-fx-padding:16 0;"/>
                    </children>
                </VBox>

            </children>
        </HBox>

        <!-- ═══════════════════════════════════════════
             ROW 4: THỐNG KÊ XE THEO TRẠNG THÁI + DOANH THU THEO THÁNG NÀY
        ═══════════════════════════════════════════ -->
        <HBox prefHeight="260.0" spacing="16.0">
            <children>

                <!-- Thống kê nhanh xe -->
                <VBox prefHeight="260.0" prefWidth="320.0"
                      style="-fx-background-color:white;-fx-background-radius:14;
                             -fx-effect:dropshadow(three-pass-box,rgba(0,0,0,0.05),12,0,0,4);">
                    <padding><Insets bottom="16.0" left="18.0" right="18.0" top="16.0"/></padding>
                    <children>
                        <Label style="-fx-font-size:15px;-fx-font-weight:bold;-fx-text-fill:#1e293b;"
                               text="🚦  Trạng thái đội xe"/>
                        <Label style="-fx-font-size:11px;-fx-text-fill:#94a3b8;-fx-padding:0 0 10 0;"
                               text="Thời điểm hiện tại"/>

                        <!-- Grid thống kê xe -->
                        <GridPane hgap="10.0" vgap="10.0" VBox.vgrow="ALWAYS">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0"/>
                                <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0"/>
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="55.0"/>
                                <RowConstraints minHeight="55.0"/>
                            </rowConstraints>
                            <children>
                                <!-- Sẵn sàng -->
                                <VBox alignment="CENTER" spacing="4.0"
                                      style="-fx-background-color:#f0fdf4;-fx-background-radius:10;-fx-padding:10;"
                                      GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <children>
                                        <Label fx:id="lblVehAvailable"
                                               style="-fx-font-size:26px;-fx-font-weight:bold;-fx-text-fill:#16a34a;"
                                               text="--"/>
                                        <Label style="-fx-font-size:11px;-fx-text-fill:#15803d;" text="Sẵn sàng"/>
                                    </children>
                                </VBox>
                                <!-- Đang thuê -->
                                <VBox alignment="CENTER" spacing="4.0"
                                      style="-fx-background-color:#fff7ed;-fx-background-radius:10;-fx-padding:10;"
                                      GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <children>
                                        <Label fx:id="lblVehRented"
                                               style="-fx-font-size:26px;-fx-font-weight:bold;-fx-text-fill:#ea580c;"
                                               text="--"/>
                                        <Label style="-fx-font-size:11px;-fx-text-fill:#c2410c;" text="Đang thuê"/>
                                    </children>
                                </VBox>
                                <!-- Bảo dưỡng -->
                                <VBox alignment="CENTER" spacing="4.0"
                                      style="-fx-background-color:#fef2f2;-fx-background-radius:10;-fx-padding:10;"
                                      GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <children>
                                        <Label fx:id="lblVehMaintenance"
                                               style="-fx-font-size:26px;-fx-font-weight:bold;-fx-text-fill:#dc2626;"
                                               text="--"/>
                                        <Label style="-fx-font-size:11px;-fx-text-fill:#b91c1c;" text="Bảo dưỡng"/>
                                    </children>
                                </VBox>
                                <!-- Tổng xe -->
                                <VBox alignment="CENTER" spacing="4.0"
                                      style="-fx-background-color:#f0f9ff;-fx-background-radius:10;-fx-padding:10;"
                                      GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <children>
                                        <Label fx:id="lblVehTotal"
                                               style="-fx-font-size:26px;-fx-font-weight:bold;-fx-text-fill:#0284c7;"
                                               text="--"/>
                                        <Label style="-fx-font-size:11px;-fx-text-fill:#0369a1;" text="Tổng xe"/>
                                    </children>
                                </VBox>
                            </children>
                        </GridPane>
                    </children>
                </VBox>

                <!-- Doanh thu tháng hiện tại chi tiết -->
                <VBox prefHeight="260.0"
                      style="-fx-background-color:white;-fx-background-radius:14;
                             -fx-effect:dropshadow(three-pass-box,rgba(0,0,0,0.05),12,0,0,4);"
                      HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="16.0" left="18.0" right="18.0" top="16.0"/></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
