<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER"
            style="-fx-background-color: #f4f7f6; -fx-background: #f4f7f6;"
            stylesheets="@../../css/reportview/reportstyle.css"
            xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.rentalcar.controller.report.ReportController">
    <content>

        <VBox spacing="22.0" style="-fx-background-color: #f4f7f6; -fx-min-width: 1040px;">
            <padding>
                <Insets bottom="40.0" left="32.0" right="32.0" top="28.0" />
            </padding>
            <children>

                <!-- ============================================================
                     HEADER
                ============================================================ -->
                <HBox alignment="CENTER_LEFT" spacing="14.0">
                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Text strokeType="OUTSIDE" strokeWidth="0.0"
                                      text="Báo cáo &amp; Thống kê">
                                    <font><Font name="System Bold" size="30.0" /></font>
                                </Text>
                                <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"
                                       text="Tổng hợp hiệu suất kinh doanh theo năm" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />

                        <!-- Chọn năm -->
                        <HBox alignment="CENTER" spacing="4.0"
                              style="-fx-background-color: white; -fx-background-radius: 12;
                                     -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.07),10,0,0,3);
                                     -fx-padding: 5 10;">
                            <children>
                                <Button fx:id="btnPrevYear" mnemonicParsing="false"
                                        onAction="#handlePrevYear"
                                        style="-fx-background-color: transparent; -fx-text-fill: #64748b;
                                               -fx-font-size: 18px; -fx-cursor: hand; -fx-padding: 2 8;"
                                        text="‹" />
                                <Label fx:id="lblYear"
                                       style="-fx-font-size: 16px; -fx-font-weight: bold;
                                              -fx-text-fill: #1e293b; -fx-min-width: 54px;
                                              -fx-alignment: center;"
                                       text="2026" />
                                <Button fx:id="btnNextYear" mnemonicParsing="false"
                                        onAction="#handleNextYear"
                                        style="-fx-background-color: transparent; -fx-text-fill: #64748b;
                                               -fx-font-size: 18px; -fx-cursor: hand; -fx-padding: 2 8;"
                                        text="›" />
                            </children>
                        </HBox>

                        <!-- Xuất báo cáo -->
                        <Button mnemonicParsing="false" onAction="#handleExport"
                                styleClass="btn-export"
                                style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569;
                                       -fx-background-radius: 10; -fx-font-weight: bold;
                                       -fx-cursor: hand; -fx-padding: 10 18; -fx-font-size: 13px;"
                                text="⬇  Xuất báo cáo" />
                    </children>
                </HBox>

                <!-- ============================================================
                     4 KPI CARDS
                ============================================================ -->
                <GridPane hgap="18.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0" />
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0" />
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0" />
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="25.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints prefHeight="120.0" />
                    </rowConstraints>
                    <children>

                        <!-- Card 1: Doanh thu năm -->
                        <AnchorPane prefHeight="120.0" styleClass="kpi-card kpi-blue"
                                    GridPane.columnIndex="0">
                            <children>
                                <Label styleClass="kpi-label" text="Doanh thu năm"
                                       AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0" />
                                <Label fx:id="lblYearRevenue" styleClass="kpi-value" text="--"
                                       AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="38.0">
                                    <font><Font name="System Bold" size="22.0" /></font>
                                </Label>
                                <Label fx:id="lblRevenueGrowth"
                                       style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size:12px;"
                                       text="--"
                                       AnchorPane.leftAnchor="18.0" AnchorPane.bottomAnchor="12.0"
                                       AnchorPane.rightAnchor="12.0" wrapText="true" />
                                <Label styleClass="kpi-icon" text="💰"
                                       AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                                    <font><Font size="30.0" /></font>
                                </Label>
                            </children>
                        </AnchorPane>

                        <!-- Card 2: Hợp đồng hoàn thành -->
                        <AnchorPane prefHeight="120.0" styleClass="kpi-card kpi-green"
                                    GridPane.columnIndex="1">
                            <children>
                                <Label styleClass="kpi-label" text="Hợp đồng hoàn thành"
                                       AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0" />
                                <Label fx:id="lblYearContracts" styleClass="kpi-value" text="--"
                                       AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="38.0">
                                    <font><Font name="System Bold" size="28.0" /></font>
                                </Label>
                                <Label fx:id="lblContractSub"
                                       style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size:12px;"
                                       text="trong năm"
                                       AnchorPane.leftAnchor="18.0" AnchorPane.bottomAnchor="12.0" />
                                <Label styleClass="kpi-icon" text="📋"
                                       AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                                    <font><Font size="30.0" /></font>
                                </Label>
                            </children>
                        </AnchorPane>

                        <!-- Card 3: Khách hàng -->
                        <AnchorPane prefHeight="120.0" styleClass="kpi-card kpi-purple"
                                    GridPane.columnIndex="2">
                            <children>
                                <Label styleClass="kpi-label" text="Khách hàng đã thuê"
                                       AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0" />
                                <Label fx:id="lblTotalCustomers" styleClass="kpi-value" text="--"
                                       AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="38.0">
                                    <font><Font name="System Bold" size="28.0" /></font>
                                </Label>
                                <Label style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size:12px;"
                                       text="khách hàng phát sinh đơn"
                                       AnchorPane.leftAnchor="18.0" AnchorPane.bottomAnchor="12.0" />
                                <Label styleClass="kpi-icon" text="👥"
                                       AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                                    <font><Font size="30.0" /></font>
                                </Label>
                            </children>
                        </AnchorPane>

                        <!-- Card 4: Doanh thu TB / tháng -->
                        <AnchorPane prefHeight="120.0" styleClass="kpi-card kpi-orange"
                                    GridPane.columnIndex="3">
                            <children>
                                <Label styleClass="kpi-label" text="DT trung bình / tháng"
                                       AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0" />
                                <Label fx:id="lblAvgMonthly" styleClass="kpi-value" text="--"
                                       AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="38.0">
                                    <font><Font name="System Bold" size="20.0" /></font>
                                </Label>
                                <Label style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size:12px;"
                                       text="tính trên 12 tháng"
                                       AnchorPane.leftAnchor="18.0" AnchorPane.bottomAnchor="12.0" />
                                <Label styleClass="kpi-icon" text="📈"
                                       AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                                    <font><Font size="30.0" /></font>
                                </Label>
                            </children>
                        </AnchorPane>
                    </children>
                </GridPane>

                <!-- ============================================================
                     ROW 2: BAR CHART (65%) + PIE CHART (35%)
                ============================================================ -->
                <HBox prefHeight="370.0" spacing="18.0">
                    <children>

                        <!-- BAR CHART -->
                        <VBox spacing="12.0" styleClass="panel" HBox.hgrow="ALWAYS">
                            <padding>
                                <Insets bottom="20.0" left="22.0" right="22.0" top="18.0" />
                            </padding>
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <VBox spacing="3.0">
                                            <children>
                                                <Label styleClass="panel-title"
                                                       text="Doanh thu theo tháng" />
                                                <Label fx:id="lblChartSubtitle"
                                                       styleClass="panel-subtitle"
                                                       text="Đơn vị: triệu đồng" />
                                            </children>
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblPeakMonth"
                                               style="-fx-background-color: #eff6ff;
                                                      -fx-text-fill: #1d4ed8;
                                                      -fx-background-radius: 8;
                                                      -fx-padding: 5 12;
                                                      -fx-font-size: 12px;
                                                      -fx-font-weight: bold;"
                                               text="" visible="false" />
                                    </children>
                                </HBox>

                                <BarChart fx:id="barChartRevenue"
                                          animated="false"
                                          barGap="3" categoryGap="12"
                                          legendVisible="false"
                                          prefHeight="290.0"
                                          VBox.vgrow="ALWAYS">
                                    <xAxis>
                                        <CategoryAxis fx:id="xAxis" label="" side="BOTTOM" />
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis fx:id="yAxis" label="" side="LEFT" />
                                    </yAxis>
                                </BarChart>
                            </children>
                        </VBox>

                        <!-- PIE CHART -->
                        <VBox prefWidth="320.0" spacing="12.0" styleClass="panel">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="18.0" />
                            </padding>
                            <children>
                                <Label styleClass="panel-title" text="Phân bố hợp đồng" />
                                <Label styleClass="panel-subtitle"
                                       text="Theo trạng thái trong năm" />
                                <PieChart fx:id="pieChartStatus"
                                          animated="false"
                                          clockwise="true"
                                          labelsVisible="true"
                                          legendSide="BOTTOM"
                                          legendVisible="true"
                                          prefHeight="270.0"
                                          VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- ============================================================
                     ROW 3: TOP VEHICLES + TOP STAFF
                ============================================================ -->
                <HBox prefHeight="330.0" spacing="18.0">
                    <children>

                        <!-- TOP XE -->
                        <VBox spacing="14.0" styleClass="panel" HBox.hgrow="ALWAYS">
                            <padding>
                                <Insets bottom="18.0" left="22.0" right="22.0" top="18.0" />
                            </padding>
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <VBox spacing="3.0">
                                            <children>
                                                <Label styleClass="panel-title"
                                                       text="🏍  Top xe cho thuê nhiều nhất" />
                                                <Label styleClass="panel-subtitle"
                                                       text="Xếp hạng theo số lượt thuê" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <Separator style="-fx-background-color: #f1f5f9;" />

                                <TableView fx:id="tableTopVehicles"
                                           prefHeight="240.0"
                                           styleClass="rank-table"
                                           VBox.vgrow="ALWAYS">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="colVRank"
                                                     maxWidth="60.0" minWidth="60.0"
                                                     text="#" />
                                        <TableColumn fx:id="colVName"
                                                     prefWidth="180.0"
                                                     text="Xe" />
                                        <TableColumn fx:id="colVPlate"
                                                     prefWidth="110.0"
                                                     text="Biển số" />
                                        <TableColumn fx:id="colVCount"
                                                     prefWidth="95.0"
                                                     text="Lượt thuê" />
                                        <TableColumn fx:id="colVRevenue"
                                                     prefWidth="150.0"
                                                     text="Doanh thu" />
                                    </columns>
                                    <placeholder>
                                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size:13px;"
                                               text="Chưa có dữ liệu cho năm này" />
                                    </placeholder>
                                </TableView>
                            </children>
                        </VBox>

                        <!-- TOP NHÂN VIÊN -->
                        <VBox prefWidth="400.0" spacing="14.0" styleClass="panel">
                            <padding>
                                <Insets bottom="18.0" left="22.0" right="22.0" top="18.0" />
                            </padding>
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <VBox spacing="3.0">
                                            <children>
                                                <Label styleClass="panel-title"
                                                       text="🏆  Top nhân viên xuất sắc" />
                                                <Label styleClass="panel-subtitle"
                                                       text="Xếp hạng theo doanh thu tạo ra" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <Separator style="-fx-background-color: #f1f5f9;" />

                                <TableView fx:id="tableTopStaff"
                                           prefHeight="240.0"
                                           styleClass="rank-table"
                                           VBox.vgrow="ALWAYS">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="colSRank"
                                                     maxWidth="60.0" minWidth="60.0"
                                                     text="#" />
                                        <TableColumn fx:id="colSName"
                                                     prefWidth="160.0"
                                                     text="Nhân viên" />
                                        <TableColumn fx:id="colSContracts"
                                                     prefWidth="80.0"
                                                     text="Số HĐ" />
                                        <TableColumn fx:id="colSRevenue"
                                                     prefWidth="140.0"
                                                     text="Doanh thu" />
                                    </columns>
                                    <placeholder>
                                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size:13px;"
                                               text="Chưa có dữ liệu cho năm này" />
                                    </placeholder>
                                </TableView>
                            </children>
                        </VBox>

                    </children>
                </HBox>

            </children>
        </VBox>
    </content>
</ScrollPane>
