<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="800.0" spacing="20.0" styleClass="modal-container"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.rentalcar.controller.customer.AddCustomerController">

    <padding>
        <Insets bottom="28.0" left="36.0" right="36.0" top="26.0" />
    </padding>

    <children>

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox spacing="3.0">
                    <children>
                        <Label styleClass="header-title" text="Thêm khách hàng mới" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"
                               text="Điền thông tin và tải ảnh CCCD để hoàn tất" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnClose" mnemonicParsing="false" styleClass="btn-close" text="✕" />
            </children>
        </HBox>

        <!-- FORM THÔNG TIN -->
        <GridPane hgap="22.0" vgap="16.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="65.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="65.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="65.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>

                <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <children>
                        <Label styleClass="input-label" text="Họ tên *" />
                        <TextField fx:id="txtName" promptText="Nguyễn Văn A" styleClass="modern-input" />
                    </children>
                </VBox>

                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <children>
                        <Label styleClass="input-label" text="Số điện thoại *" />
                        <TextField fx:id="txtPhone" promptText="0905xxxxxx" styleClass="modern-input" />
                    </children>
                </VBox>

                <VBox spacing="5.0" GridPane.columnSpan="2" GridPane.rowIndex="1">
                    <children>
                        <Label styleClass="input-label" text="Số CCCD *" />
                        <TextField fx:id="txtCccd" promptText="04620600xxx" styleClass="modern-input" />
                    </children>
                </VBox>

                <VBox spacing="5.0" GridPane.rowIndex="2">
                    <children>
                        <Label styleClass="input-label" text="Địa chỉ" />
                        <TextField fx:id="txtAddress" promptText="Số nhà, tên đường..." styleClass="modern-input" />
                    </children>
                </VBox>

                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <children>
                        <Label styleClass="input-label" text="Email (tùy chọn)" />
                        <TextField fx:id="txtEmail" promptText="example@gmail.com" styleClass="modern-input" />
                    </children>
                </VBox>

            </children>
        </GridPane>

        <!-- ====================================================
             UPLOAD ẢNH CCCD – 2 ảnh, mỗi ảnh có preview riêng
        ==================================================== -->
        <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;"
               text="📋  Ảnh CCCD (Căn cước công dân)" />

        <HBox spacing="20.0">
            <children>

                <!-- MẶT TRƯỚC -->
                <VBox spacing="8.0" HBox.hgrow="ALWAYS"
                      style="-fx-border-color: #cbd5e1; -fx-border-style: dashed; -fx-border-width: 2;
                             -fx-background-color: #f8fafc; -fx-background-radius: 12; -fx-border-radius: 12;
                             -fx-padding: 14; -fx-alignment: center;">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;"
                               text="MẶT TRƯỚC" />

                        <!-- Preview -->
                        <StackPane prefWidth="220.0" prefHeight="130.0"
                                   style="-fx-background-color: #e2e8f0; -fx-background-radius: 8;">
                            <children>
                                <ImageView fx:id="imgFront"
                                           fitWidth="216.0" fitHeight="126.0"
                                           preserveRatio="true" pickOnBounds="true" />
                            </children>
                        </StackPane>

                        <Button mnemonicParsing="false"
                                onAction="#handleUploadFront"
                                prefHeight="38.0" maxWidth="Infinity"
                                style="-fx-background-color: #0ea5e9; -fx-text-fill: white;
                                       -fx-background-radius: 8; -fx-cursor: hand;
                                       -fx-font-weight: bold; -fx-font-size: 12px;"
                                text="📂  Chọn ảnh mặt trước" />

                        <Label fx:id="lblFrontStatus" text="" managed="false" visible="false"
                               style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                    </children>
                </VBox>

                <!-- MẶT SAU -->
                <VBox spacing="8.0" HBox.hgrow="ALWAYS"
                      style="-fx-border-color: #cbd5e1; -fx-border-style: dashed; -fx-border-width: 2;
                             -fx-background-color: #f8fafc; -fx-background-radius: 12; -fx-border-radius: 12;
                             -fx-padding: 14; -fx-alignment: center;">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;"
                               text="MẶT SAU" />

                        <!-- Preview -->
                        <StackPane prefWidth="220.0" prefHeight="130.0"
                                   style="-fx-background-color: #e2e8f0; -fx-background-radius: 8;">
                            <children>
                                <ImageView fx:id="imgBack"
                                           fitWidth="216.0" fitHeight="126.0"
                                           preserveRatio="true" pickOnBounds="true" />
                            </children>
                        </StackPane>

                        <Button mnemonicParsing="false"
                                onAction="#handleUploadBack"
                                prefHeight="38.0" maxWidth="Infinity"
                                style="-fx-background-color: #0ea5e9; -fx-text-fill: white;
                                       -fx-background-radius: 8; -fx-cursor: hand;
                                       -fx-font-weight: bold; -fx-font-size: 12px;"
                                text="📂  Chọn ảnh mặt sau" />

                        <Label fx:id="lblBackStatus" text="" managed="false" visible="false"
                               style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                    </children>
                </VBox>

            </children>
        </HBox>

        <!-- BUTTONS -->
        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <VBox.margin><Insets top="8.0" /></VBox.margin>
            <children>
                <Button fx:id="btnCancel" mnemonicParsing="false" styleClass="btn-cancel" text="Hủy bỏ" />
                <Button fx:id="btnSave"   mnemonicParsing="false" styleClass="btn-primary" text="💾  Lưu khách hàng" />
            </children>
        </HBox>

    </children>

    <stylesheets>
        <URL value="@../../css/customerview/modal_style.css" />
    </stylesheets>
</VBox>
