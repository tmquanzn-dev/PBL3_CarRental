<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="480.0" spacing="18.0"
      style="-fx-background-color: white; -fx-background-radius: 14;
             -fx-border-color: #e2e8f0; -fx-border-radius: 14;"
      stylesheets="@../../css/customerview/customerstyle.css"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.rentalcar.controller.customer.BlacklistModalController">

    <padding>
        <Insets bottom="28.0" left="32.0" right="32.0" top="24.0" />
    </padding>

    <children>

        <!-- Header -->
        <VBox spacing="4.0">
            <children>
                <Label text="⛔  Thêm vào danh sách đen"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                <Label text="Khách hàng sẽ bị cấm thuê xe cho đến khi được gỡ."
                       style="-fx-text-fill: #64748b; -fx-font-size: 13px;" />
            </children>
        </VBox>

        <!-- Thông tin khách -->
        <VBox spacing="6.0"
              style="-fx-background-color: #fff1f2; -fx-background-radius: 10;
                     -fx-border-color: #fca5a5; -fx-border-radius: 10; -fx-padding: 14 16;">
            <children>
                <Label fx:id="lblCustomerName"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #b91c1c;" text="--" />
                <Label fx:id="lblCustomerCccd"
                       style="-fx-font-size: 13px; -fx-text-fill: #64748b;" text="CCCD: --" />
            </children>
        </VBox>

        <!-- Lý do -->
        <VBox spacing="6.0">
            <children>
                <Label text="Lý do đưa vào danh sách đen *"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                <TextArea fx:id="txtReason"
                          prefHeight="100.0"
                          promptText="VD: Không thanh toán, làm hỏng xe, vi phạm hợp đồng nhiều lần..."
                          wrapText="true"
                          style="-fx-background-color: white; -fx-border-color: #cbd5e1;
                                 -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 12;
                                 -fx-font-size: 14px;" />
            </children>
        </VBox>

        <!-- Toast msg -->
        <Label fx:id="lblMsg" text="" visible="false"
               style="-fx-font-size: 13px;" />

        <!-- Buttons -->
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <children>
                <Button fx:id="btnCancel" mnemonicParsing="false" onAction="#handleCancel"
                        text="Hủy bỏ"
                        style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569;
                               -fx-background-radius: 8; -fx-padding: 10 24; -fx-cursor: hand;
                               -fx-font-weight: bold;" />
                <Button fx:id="btnConfirm" mnemonicParsing="false" onAction="#handleConfirm"
                        text="⛔  Xác nhận Blacklist"
                        style="-fx-background-color: #ef4444; -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-padding: 10 24; -fx-cursor: hand;
                               -fx-font-weight: bold;">
                    <font><Font name="System Bold" size="13.0" /></font>
                </Button>
            </children>
        </HBox>

    </children>
</VBox>
