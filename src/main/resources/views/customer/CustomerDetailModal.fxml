<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import java.net.URL?>

<VBox prefWidth="550.0" spacing="20.0" styleClass="modal-container" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.rentalcar.controller.customer.CustomerDetailController">
    <stylesheets>
        <URL value="@../../css/customerview/customer_detail.css" />
    </stylesheets>

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label text="CHI TIẾT KHÁCH HÀNG" textFill="#555555">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblStatus" styleClass="status-badge" text="BÌNH THƯỜNG" />
            </children>
        </HBox>

        <Separator prefWidth="200.0" />

        <GridPane vgap="18.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="10.0" prefWidth="130.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="350.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" /><RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" /><RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" /><RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" /><RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" /><RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label styleClass="info-label" text="Họ tên:" />
                <Label fx:id="lblFullName" styleClass="info-value-name" text="Đang tải..." GridPane.columnIndex="1" />

                <Label styleClass="info-label" text="Số điện thoại:" GridPane.rowIndex="1" />
                <Label fx:id="lblPhone" styleClass="info-value" text="Đang tải..." GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label styleClass="info-label" text="Số CCCD:" GridPane.rowIndex="2" />
                <Label fx:id="lblCccd" styleClass="info-value" text="Đang tải..." GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label styleClass="info-label" text="Địa chỉ:" GridPane.rowIndex="3" />
                <Label fx:id="lblAddress" styleClass="info-value" text="Đang tải..." wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label styleClass="info-label" text="Email:" GridPane.rowIndex="4" />
                <Label fx:id="lblEmail" styleClass="info-value" text="Đang tải..." GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <Label styleClass="info-label" text="Số lần thuê:" GridPane.rowIndex="5" />
                <Label fx:id="lblRentalCount" styleClass="info-value-rental" text="0 lần" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            </children>
        </GridPane>

        <Separator prefWidth="200.0" />

        <VBox spacing="10.0">
            <children>
                <Label styleClass="info-label" text="Ảnh CCCD đã lưu:" />
                <HBox alignment="CENTER" spacing="20.0" styleClass="image-container-box">
                    <children>
                        <ImageView fx:id="imgFront" fitHeight="120.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" styleClass="cccd-image" />
                        <ImageView fx:id="imgBack" fitHeight="120.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" styleClass="cccd-image" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <Separator prefWidth="200.0" />

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <children>
                <Button onAction="#handleClose" prefHeight="38.0" prefWidth="90.0" styleClass="btn-close-modal" text="Đóng" />
            </children>
        </HBox>
    </children>
</VBox>