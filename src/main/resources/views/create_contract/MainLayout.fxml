<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="780.0" prefWidth="960.0"
            style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.rentalcar.controller.contract.booking.CreateContractController">
    <children>
        <VBox spacing="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <!-- ===== TOP HEADER ===== -->
            <HBox alignment="CENTER_LEFT" prefHeight="64.0"
                  style="-fx-background-color: linear-gradient(to right, #1d4ed8, #2563eb);
                         -fx-padding: 0 28;">
                <children>
                    <Label text="🏍" style="-fx-font-size: 22px;"/>
                    <VBox spacing="1.0" style="-fx-padding: 0 0 0 10;">
                        <children>
                            <Label text="Tạo hợp đồng thuê xe"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label text="Điền đầy đủ 4 bước để hoàn tất"
                                   style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.75);"/>
                        </children>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button mnemonicParsing="false" onAction="#handleCancel"
                            style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                                   -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 6 16;
                                   -fx-font-size: 13px;"
                            text="✕  Hủy"/>
                </children>
            </HBox>

            <!-- ===== STEPPER ===== -->
            <HBox alignment="CENTER" prefHeight="72.0" spacing="0.0"
                  style="-fx-background-color: #f8faff;
                         -fx-border-color: transparent transparent #e5e7eb transparent;
                         -fx-border-width: 0 0 1 0;">
                <children>
                    <!-- Step 1 -->
                    <VBox fx:id="step1Box" alignment="CENTER" prefWidth="220.0" spacing="4.0">
                        <children>
                            <HBox alignment="CENTER" spacing="8.0">
                                <children>
                                    <Label text="1" style="-fx-background-color: #2563eb; -fx-text-fill: white;
                                                           -fx-font-weight: bold; -fx-font-size: 13px;
                                                           -fx-background-radius: 50; -fx-min-width: 28;
                                                           -fx-min-height: 28; -fx-alignment: center;"/>
                                    <Label text="Khách hàng"
                                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
                                </children>
                            </HBox>
                        </children>
                    </VBox>

                    <!-- Line -->
                    <Region prefWidth="40.0" prefHeight="2.0"
                            style="-fx-background-color: #d1d5db; -fx-max-height: 2;"/>

                    <!-- Step 2 -->
                    <VBox fx:id="step2Box" alignment="CENTER" prefWidth="220.0" spacing="4.0">
                        <children>
                            <HBox alignment="CENTER" spacing="8.0">
                                <children>
                                    <Label text="2" style="-fx-background-color: #9ca3af; -fx-text-fill: white;
                                                           -fx-font-weight: bold; -fx-font-size: 13px;
                                                           -fx-background-radius: 50; -fx-min-width: 28;
                                                           -fx-min-height: 28; -fx-alignment: center;"/>
                                    <Label text="Chọn xe"
                                           style="-fx-font-size: 13px; -fx-text-fill: #9ca3af;"/>
                                </children>
                            </HBox>
                        </children>
                    </VBox>

                    <!-- Line -->
                    <Region prefWidth="40.0" prefHeight="2.0"
                            style="-fx-background-color: #d1d5db; -fx-max-height: 2;"/>

                    <!-- Step 3 -->
                    <VBox fx:id="step3Box" alignment="CENTER" prefWidth="220.0" spacing="4.0">
                        <children>
                            <HBox alignment="CENTER" spacing="8.0">
                                <children>
                                    <Label text="3" style="-fx-background-color: #9ca3af; -fx-text-fill: white;
                                                           -fx-font-weight: bold; -fx-font-size: 13px;
                                                           -fx-background-radius: 50; -fx-min-width: 28;
                                                           -fx-min-height: 28; -fx-alignment: center;"/>
                                    <Label text="Thời gian &amp; Cọc"
                                           style="-fx-font-size: 13px; -fx-text-fill: #9ca3af;"/>
                                </children>
                            </HBox>
                        </children>
                    </VBox>

                    <!-- Line -->
                    <Region prefWidth="40.0" prefHeight="2.0"
                            style="-fx-background-color: #d1d5db; -fx-max-height: 2;"/>

                    <!-- Step 4 -->
                    <VBox fx:id="step4Box" alignment="CENTER" prefWidth="220.0" spacing="4.0">
                        <children>
                            <HBox alignment="CENTER" spacing="8.0">
                                <children>
                                    <Label text="4" style="-fx-background-color: #9ca3af; -fx-text-fill: white;
                                                           -fx-font-weight: bold; -fx-font-size: 13px;
                                                           -fx-background-radius: 50; -fx-min-width: 28;
                                                           -fx-min-height: 28; -fx-alignment: center;"/>
                                    <Label text="Xác nhận"
                                           style="-fx-font-size: 13px; -fx-text-fill: #9ca3af;"/>
                                </children>
                            </HBox>
                        </children>
                    </VBox>
                </children>
            </HBox>

            <!-- ===== CONTENT AREA ===== -->
            <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS"
                       style="-fx-padding: 20 28 16 28; -fx-background-color: white;">
            </StackPane>

            <!-- ===== BOTTOM BUTTONS ===== -->
            <HBox alignment="CENTER_RIGHT" prefHeight="64.0" spacing="12.0"
                  style="-fx-background-color: #f9fafb;
                         -fx-border-color: #e5e7eb transparent transparent transparent;
                         -fx-border-width: 1 0 0 0; -fx-padding: 0 28;">
                <children>
                    <Button fx:id="btnBack" onAction="#handleBack"
                            prefHeight="42.0" prefWidth="120.0"
                            style="-fx-background-color: white; -fx-text-fill: #374151;
                                   -fx-border-color: #d1d5db; -fx-border-radius: 8;
                                   -fx-background-radius: 8; -fx-font-weight: bold;
                                   -fx-cursor: hand; -fx-font-size: 13px;"
                            text="← Quay lại"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnNext" onAction="#handleNext"
                            prefHeight="42.0" prefWidth="200.0"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white;
                                   -fx-background-radius: 8; -fx-font-weight: bold;
                                   -fx-cursor: hand; -fx-font-size: 14px;
                                   -fx-effect: dropshadow(three-pass-box,rgba(37,99,235,0.4),10,0,0,3);"
                            text="Tiếp theo →">
                        <font><Font name="System Bold" size="14.0"/></font>
                    </Button>
                </children>
            </HBox>

        </VBox>
    </children>
</AnchorPane>
