<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="16.0"
      style="-fx-background-color: white;"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.rentalcar.controller.contract.booking.Step2Controller">

    <padding><Insets top="4.0" bottom="4.0"/></padding>

    <children>

        <!-- Step header -->
        <VBox spacing="4.0"
              style="-fx-background-color: linear-gradient(to right, #eff6ff, #f8faff);
                     -fx-background-radius: 12; -fx-padding: 18 20; -fx-border-color: #dbeafe;
                     -fx-border-radius: 12; -fx-border-width: 1;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="🏍" style="-fx-font-size: 22px;"/>
                        <VBox spacing="2.0">
                            <children>
                                <Label text="Chọn xe thuê"
                                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
                                <Label text="Chỉ hiển thị xe đang sẵn sàng cho thuê"
                                       style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblSelectedVehicle" text="Chưa chọn xe"
                               style="-fx-text-fill: #6b7280; -fx-font-size: 13px;
                                      -fx-background-color: #f3f4f6; -fx-background-radius: 8;
                                      -fx-padding: 6 12;"/>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Filter bar -->
        <HBox spacing="10.0" alignment="CENTER_LEFT"
              style="-fx-background-color: #f9fafb; -fx-background-radius: 10;
                     -fx-border-color: #e5e7eb; -fx-border-radius: 10;
                     -fx-padding: 12 16; -fx-border-width: 1;">
            <children>
                <TextField fx:id="txtSearch"
                           prefHeight="38.0" prefWidth="220.0"
                           promptText="🔍 Biển số, tên xe..."
                           style="-fx-background-color: white; -fx-background-radius: 8;
                                  -fx-border-color: #d1d5db; -fx-border-radius: 8;
                                  -fx-padding: 0 10; -fx-font-size: 13px;"/>

                <ComboBox fx:id="cbBrand"
                          prefHeight="38.0" prefWidth="140.0"
                          promptText="Hãng xe"
                          style="-fx-background-color: white; -fx-border-color: #d1d5db;
                                 -fx-border-radius: 8; -fx-background-radius: 8;"/>

                <ComboBox fx:id="cbType"
                          prefHeight="38.0" prefWidth="140.0"
                          promptText="Loại xe"
                          style="-fx-background-color: white; -fx-border-color: #d1d5db;
                                 -fx-border-radius: 8; -fx-background-radius: 8;"/>

                <Button mnemonicParsing="false" onAction="#handleFilter"
                        prefHeight="38.0" prefWidth="80.0"
                        style="-fx-background-color: #3b82f6; -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;
                               -fx-font-size: 13px;"
                        text="Lọc"/>
            </children>
        </HBox>

        <!-- Vehicle cards -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: transparent; -fx-background: transparent;"
                    prefHeight="430.0"
                    VBox.vgrow="ALWAYS">
            <content>
                <FlowPane fx:id="flowPaneVehicles" hgap="16.0" vgap="16.0">
                    <padding>
                        <Insets bottom="10.0" left="2.0" right="2.0" top="2.0"/>
                    </padding>
                </FlowPane>
            </content>
        </ScrollPane>

    </children>
</VBox>
