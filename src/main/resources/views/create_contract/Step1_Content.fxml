<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0"
      style="-fx-background-color: white;"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.rentalcar.controller.contract.booking.Step1Controller">

    <padding><Insets top="4.0" bottom="4.0"/></padding>

    <children>

        <!-- Step header -->
        <VBox spacing="4.0"
              style="-fx-background-color: linear-gradient(to right, #eff6ff, #f8faff);
                     -fx-background-radius: 12; -fx-padding: 18 20; -fx-border-color: #dbeafe;
                     -fx-border-radius: 12; -fx-border-width: 1;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="👤" style="-fx-font-size: 22px;"/>
                        <VBox spacing="2.0">
                            <children>
                                <Label text="Thông tin khách hàng"
                                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
                                <Label text="Tra cứu theo CCCD để tìm khách hàng cũ hoặc thêm mới"
                                       style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- CCCD search row -->
        <VBox spacing="6.0">
            <children>
                <Label text="Tra cứu nhanh theo số CCCD / CMND"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                <HBox spacing="10.0">
                    <children>
                        <TextField fx:id="txtSearchCCCD"
                                   prefHeight="44.0"
                                   promptText="Nhập số CCCD hoặc CMND..."
                                   style="-fx-background-color: white;
                                          -fx-background-radius: 8; -fx-border-color: #d1d5db;
                                          -fx-border-radius: 8; -fx-padding: 0 14;
                                          -fx-font-size: 14px; -fx-text-fill: #111827;"
                                   HBox.hgrow="ALWAYS"/>
                        <Button mnemonicParsing="false"
                                onAction="#handleSearchCCCD"
                                prefHeight="44.0" prefWidth="130.0"
                                style="-fx-background-color: #2563eb; -fx-text-fill: white;
                                       -fx-background-radius: 8; -fx-font-weight: bold;
                                       -fx-cursor: hand; -fx-font-size: 13px;"
                                text="🔍  Tìm kiếm"/>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- BLACKLIST WARNING -->
        <HBox fx:id="boxBlacklistWarning"
              alignment="CENTER_LEFT"
              spacing="12.0"
              managed="false"
              visible="false"
              style="-fx-background-color: #fef2f2; -fx-background-radius: 10;
                     -fx-border-color: #fca5a5; -fx-border-radius: 10; -fx-border-width: 0 0 0 4;
                     -fx-padding: 14 18;">
            <children>
                <Label text="⛔" style="-fx-font-size: 24px;"/>
                <VBox spacing="3.0">
                    <children>
                        <Label text="KHÁCH HÀNG BỊ CẤM THUÊ XE"
                               style="-fx-font-weight: bold; -fx-text-fill: #991b1b; -fx-font-size: 14px;"/>
                        <Label fx:id="lblBlacklistReason"
                               text="Lý do: Chưa có thông tin"
                               style="-fx-text-fill: #dc2626; -fx-font-size: 13px;"
                               wrapText="true"/>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Form info -->
        <VBox spacing="0.0"
              style="-fx-background-color: white; -fx-background-radius: 12;
                     -fx-border-color: #e5e7eb; -fx-border-radius: 12; -fx-border-width: 1.5;">
            <children>
                <!-- Section header -->
                <HBox style="-fx-background-color: #f9fafb; -fx-background-radius: 12 12 0 0;
                              -fx-padding: 12 18; -fx-border-color: transparent transparent #e5e7eb transparent;
                              -fx-border-width: 0 0 1 0;">
                    <children>
                        <Label text="Thông tin cơ bản"
                               style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 13px;"/>
                    </children>
                </HBox>

                <GridPane hgap="16.0" vgap="14.0" style="-fx-padding: 18;">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="62.0"/>
                        <RowConstraints minHeight="62.0"/>
                    </rowConstraints>
                    <children>

                        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <children>
                                <Label text="Họ và tên *"
                                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6b7280;"/>
                                <TextField fx:id="txtName" prefHeight="42.0"
                                           promptText="Nguyễn Văn A"
                                           style="-fx-background-color: white; -fx-background-radius: 8;
                                                  -fx-border-color: #d1d5db; -fx-border-radius: 8;
                                                  -fx-padding: 0 12; -fx-font-size: 14px;"/>
                            </children>
                        </VBox>

                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <children>
                                <Label text="Số điện thoại *"
                                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6b7280;"/>
                                <TextField fx:id="txtPhone" prefHeight="42.0"
                                           promptText="0905 xxx xxx"
                                           style="-fx-background-color: white; -fx-background-radius: 8;
                                                  -fx-border-color: #d1d5db; -fx-border-radius: 8;
                                                  -fx-padding: 0 12; -fx-font-size: 14px;"/>
                            </children>
                        </VBox>

                        <VBox spacing="5.0" GridPane.columnSpan="2" GridPane.rowIndex="1">
                            <children>
                                <Label text="Địa chỉ"
                                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6b7280;"/>
                                <TextField fx:id="txtAddress" prefHeight="42.0"
                                           promptText="Số nhà, đường, phường/xã, quận/huyện..."
                                           style="-fx-background-color: white; -fx-background-radius: 8;
                                                  -fx-border-color: #d1d5db; -fx-border-radius: 8;
                                                  -fx-padding: 0 12; -fx-font-size: 14px;"/>
                            </children>
                        </VBox>

                    </children>
                </GridPane>
            </children>
        </VBox>

        <!-- CCCD Images upload -->
        <VBox spacing="10.0"
              style="-fx-background-color: white; -fx-background-radius: 12;
                     -fx-border-color: #e5e7eb; -fx-border-radius: 12; -fx-border-width: 1.5;">
            <children>
                <HBox style="-fx-background-color: #f9fafb; -fx-background-radius: 12 12 0 0;
                              -fx-padding: 12 18; -fx-border-color: transparent transparent #e5e7eb transparent;
                              -fx-border-width: 0 0 1 0;">
                    <children>
                        <Label text="📋  Ảnh CCCD / CMND (tùy chọn)"
                               style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 13px;"/>
                    </children>
                </HBox>

                <HBox spacing="16.0" style="-fx-padding: 16 18;">
                    <children>
                        <!-- Mặt trước -->
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS"
                              style="-fx-border-color: #d1d5db; -fx-border-style: dashed;
                                     -fx-border-width: 1.5; -fx-border-radius: 10;
                                     -fx-background-color: #f9fafb; -fx-background-radius: 10;
                                     -fx-padding: 12; -fx-alignment: center;">
                            <children>
                                <Label text="MẶT TRƯỚC"
                                       style="-fx-font-weight: bold; -fx-text-fill: #6b7280; -fx-font-size: 11px;"/>
                                <StackPane prefWidth="200.0" prefHeight="110.0"
                                           style="-fx-background-color: #e5e7eb; -fx-background-radius: 8;">
                                    <children>
                                        <ImageView fx:id="imgFront" fitWidth="196.0" fitHeight="106.0"
                                                   preserveRatio="true" pickOnBounds="true"/>
                                    </children>
                                </StackPane>
                                <Button mnemonicParsing="false" prefHeight="34.0" maxWidth="Infinity"
                                        style="-fx-background-color: #3b82f6; -fx-text-fill: white;
                                               -fx-background-radius: 7; -fx-cursor: hand;
                                               -fx-font-size: 12px; -fx-font-weight: bold;"
                                        text="📂 Chọn ảnh mặt trước"/>
                                <Label fx:id="lblFrontStatus" text="" managed="false" visible="false"
                                       style="-fx-font-size: 11px; -fx-text-fill: #16a34a; -fx-font-weight: bold;"/>
                            </children>
                        </VBox>

                        <!-- Mặt sau -->
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS"
                              style="-fx-border-color: #d1d5db; -fx-border-style: dashed;
                                     -fx-border-width: 1.5; -fx-border-radius: 10;
                                     -fx-background-color: #f9fafb; -fx-background-radius: 10;
                                     -fx-padding: 12; -fx-alignment: center;">
                            <children>
                                <Label text="MẶT SAU"
                                       style="-fx-font-weight: bold; -fx-text-fill: #6b7280; -fx-font-size: 11px;"/>
                                <StackPane prefWidth="200.0" prefHeight="110.0"
                                           style="-fx-background-color: #e5e7eb; -fx-background-radius: 8;">
                                    <children>
                                        <ImageView fx:id="imgBack" fitWidth="196.0" fitHeight="106.0"
                                                   preserveRatio="true" pickOnBounds="true"/>
                                    </children>
                                </StackPane>
                                <Button mnemonicParsing="false" prefHeight="34.0" maxWidth="Infinity"
                                        style="-fx-background-color: #3b82f6; -fx-text-fill: white;
                                               -fx-background-radius: 7; -fx-cursor: hand;
                                               -fx-font-size: 12px; -fx-font-weight: bold;"
                                        text="📂 Chọn ảnh mặt sau"/>
                                <Label fx:id="lblBackStatus" text="" managed="false" visible="false"
                                       style="-fx-font-size: 11px; -fx-text-fill: #16a34a; -fx-font-weight: bold;"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>

    </children>
</VBox>
