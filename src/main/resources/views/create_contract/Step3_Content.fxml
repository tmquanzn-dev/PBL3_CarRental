<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="16.0"
      style="-fx-background-color: white;"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.rentalcar.controller.contract.booking.Step3Controller">

    <padding><Insets top="4.0" bottom="4.0"/></padding>

    <children>

        <!-- Step header -->
        <VBox spacing="4.0"
              style="-fx-background-color: linear-gradient(to right, #eff6ff, #f8faff);
                     -fx-background-radius: 12; -fx-padding: 18 20; -fx-border-color: #dbeafe;
                     -fx-border-radius: 12; -fx-border-width: 1;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="📅" style="-fx-font-size: 22px;"/>
                        <VBox spacing="2.0">
                            <children>
                                <Label text="Thời gian, đặt cọc &amp; voucher"
                                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
                                <Label text="Chọn ngày giờ thuê và hình thức đặt cọc"
                                       style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Main 2-col layout -->
        <GridPane hgap="16.0" vgap="0.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" percentWidth="55.0"/>
                <ColumnConstraints hgrow="SOMETIMES" percentWidth="45.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="SOMETIMES"/>
            </rowConstraints>

            <children>

                <!-- LEFT: Thời gian -->
                <VBox spacing="12.0" GridPane.columnIndex="0"
                      style="-fx-background-color: white; -fx-background-radius: 12;
                             -fx-border-color: #e5e7eb; -fx-border-radius: 12;
                             -fx-border-width: 1.5; -fx-padding: 16;">
                    <children>
                        <Label text="⏰  Thời gian thuê xe"
                               style="-fx-font-weight: bold; -fx-text-fill: #1f2937; -fx-font-size: 13px;"/>

                        <!-- Bắt đầu -->
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Ngày &amp; giờ nhận xe *"
                                       style="-fx-text-fill: #6b7280; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                                <HBox spacing="8.0" alignment="CENTER_LEFT">
                                    <children>
                                        <DatePicker fx:id="dpStart" prefHeight="40.0"
                                                    style="-fx-background-radius: 8;" HBox.hgrow="ALWAYS"/>
                                        <Spinner fx:id="spinStartHour" prefWidth="62.0" prefHeight="40.0"
                                                 style="-fx-background-radius: 8;"/>
                                        <Label text=":" style="-fx-font-weight: bold; -fx-font-size: 15px;"/>
                                        <Spinner fx:id="spinStartMin" prefWidth="62.0" prefHeight="40.0"
                                                 style="-fx-background-radius: 8;"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Kết thúc -->
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Ngày &amp; giờ trả xe dự kiến *"
                                       style="-fx-text-fill: #6b7280; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                                <HBox spacing="8.0" alignment="CENTER_LEFT">
                                    <children>
                                        <DatePicker fx:id="dpEnd" prefHeight="40.0"
                                                    style="-fx-background-radius: 8;" HBox.hgrow="ALWAYS"/>
                                        <Spinner fx:id="spinEndHour" prefWidth="62.0" prefHeight="40.0"
                                                 style="-fx-background-radius: 8;"/>
                                        <Label text=":" style="-fx-font-weight: bold; -fx-font-size: 15px;"/>
                                        <Spinner fx:id="spinEndMin" prefWidth="62.0" prefHeight="40.0"
                                                 style="-fx-background-radius: 8;"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Duration display -->
                        <HBox alignment="CENTER_LEFT" spacing="8.0"
                              style="-fx-background-color: #f0fdf4; -fx-background-radius: 8;
                                     -fx-border-color: #86efac; -fx-border-radius: 8;
                                     -fx-padding: 10 14;">
                            <children>
                                <Label text="⏱" style="-fx-font-size: 16px;"/>
                                <VBox spacing="2.0">
                                    <children>
                                        <Label text="Tổng thời gian:" style="-fx-text-fill: #6b7280; -fx-font-size: 12px;"/>
                                        <Label fx:id="lblTotalDays" text="--"
                                               style="-fx-font-weight: bold; -fx-text-fill: #15803d; -fx-font-size: 14px;"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- Voucher -->
                        <VBox spacing="6.0">
                            <children>
                                <Label text="🎫  Mã giảm giá (Tùy chọn)"
                                       style="-fx-font-weight: bold; -fx-text-fill: #1f2937; -fx-font-size: 13px;"/>
                                <HBox spacing="8.0">
                                    <children>
                                        <TextField fx:id="txtVoucherCode" prefHeight="40.0"
                                                   promptText="Nhập mã voucher..."
                                                   style="-fx-background-color: white; -fx-background-radius: 8;
                                                          -fx-border-color: #d1d5db; -fx-border-radius: 8;
                                                          -fx-padding: 0 12; -fx-font-size: 14px;"
                                                   HBox.hgrow="ALWAYS"/>
                                        <Button mnemonicParsing="false" onAction="#handleApplyVoucher"
                                                prefHeight="40.0" prefWidth="90.0"
                                                style="-fx-background-color: #10b981; -fx-text-fill: white;
                                                       -fx-background-radius: 8; -fx-cursor: hand;
                                                       -fx-font-weight: bold; -fx-font-size: 12px;"
                                                text="Áp dụng"/>
                                    </children>
                                </HBox>
                                <Label fx:id="lblVoucherMsg" text="" managed="false" visible="false"
                                       style="-fx-font-size: 12px;"/>
                                <HBox fx:id="boxVoucherApplied" alignment="CENTER_LEFT" spacing="10.0"
                                      managed="false" visible="false"
                                      style="-fx-background-color: #f0fdf4; -fx-background-radius: 8;
                                             -fx-border-color: #86efac; -fx-border-radius: 8; -fx-padding: 8 12;">
                                    <children>
                                        <Label text="🎫" style="-fx-font-size: 16px;"/>
                                        <Label fx:id="lblVoucherDetail" text=""
                                               style="-fx-font-weight: bold; -fx-text-fill: #15803d;"
                                               HBox.hgrow="ALWAYS"/>
                                        <Button mnemonicParsing="false" onAction="#handleRemoveVoucher"
                                                style="-fx-background-color: transparent; -fx-text-fill: #ef4444;
                                                       -fx-cursor: hand; -fx-font-size: 14px;" text="✕"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                    </children>
                </VBox>

                <!-- RIGHT: Đặt cọc + Giá -->
                <VBox spacing="12.0" GridPane.columnIndex="1"
                      style="-fx-background-color: white; -fx-background-radius: 12;
                             -fx-border-color: #e5e7eb; -fx-border-radius: 12;
                             -fx-border-width: 1.5; -fx-padding: 16;">
                    <children>

                        <Label text="💳  Đặt cọc"
                               style="-fx-font-weight: bold; -fx-text-fill: #1f2937; -fx-font-size: 13px;"/>

                        <!-- Hình thức cọc -->
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Hình thức đặt cọc *"
                                       style="-fx-text-fill: #6b7280; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                                <ComboBox fx:id="cbDepositType" maxWidth="Infinity" prefHeight="40.0"
                                          style="-fx-background-radius: 8; -fx-border-color: #d1d5db;
                                                 -fx-border-radius: 8; -fx-font-size: 14px;"/>
                            </children>
                        </VBox>

                        <!-- Số tiền cọc -->
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Số tiền cọc (VNĐ)"
                                       style="-fx-text-fill: #6b7280; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                                <TextField fx:id="txtDepositAmount" prefHeight="40.0"
                                           promptText="VD: 500000 (bỏ trống nếu không)"
                                           style="-fx-background-color: white; -fx-background-radius: 8;
                                                  -fx-border-color: #d1d5db; -fx-border-radius: 8;
                                                  -fx-padding: 0 12; -fx-font-size: 13px;"/>
                            </children>
                        </VBox>

                        <!-- ⭐ GIẤY TỜ CCCD FIELD - hiện khi chọn Giấy tờ -->
                        <VBox fx:id="boxDepositDocument" spacing="5.0" managed="false" visible="false"
                              style="-fx-background-color: #fefce8; -fx-background-radius: 10;
                                     -fx-border-color: #fde047; -fx-border-radius: 10;
                                     -fx-border-width: 1; -fx-padding: 12;">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="6.0">
                                    <children>
                                        <Label text="🪪" style="-fx-font-size: 16px;"/>
                                        <Label text="Thông tin giấy tờ cọc"
                                               style="-fx-font-weight: bold; -fx-text-fill: #854d0e; -fx-font-size: 13px;"/>
                                    </children>
                                </HBox>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Loại giấy tờ"
                                               style="-fx-text-fill: #6b7280; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                                        <ComboBox fx:id="cbDocumentType" maxWidth="Infinity" prefHeight="38.0"
                                                  style="-fx-background-radius: 8; -fx-border-color: #fde047;
                                                         -fx-border-radius: 8; -fx-font-size: 13px;"/>
                                    </children>
                                </VBox>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Số giấy tờ cọc"
                                               style="-fx-text-fill: #6b7280; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                                        <TextField fx:id="txtDepositDocNumber" prefHeight="38.0"
                                                   promptText="VD: 046206008xxx (CCCD)"
                                                   style="-fx-background-color: white; -fx-background-radius: 8;
                                                          -fx-border-color: #fde047; -fx-border-radius: 8;
                                                          -fx-padding: 0 12; -fx-font-size: 13px;"/>
                                    </children>
                                </VBox>
                                <Label text="⚠ Giữ lại giấy tờ gốc của khách đến khi hoàn thành hợp đồng"
                                       style="-fx-text-fill: #92400e; -fx-font-size: 11px;"
                                       wrapText="true"/>
                            </children>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS"/>

                        <!-- Tổng giá -->
                        <VBox spacing="0.0"
                              style="-fx-background-color: #f8faff; -fx-background-radius: 10;
                                     -fx-border-color: #dbeafe; -fx-border-radius: 10;
                                     -fx-border-width: 1.5; -fx-padding: 14;">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Label text="Tiền thuê cơ bản:"
                                               style="-fx-text-fill: #6b7280; -fx-font-size: 12px;" prefWidth="130.0"/>
                                        <Label fx:id="lblBasePrice" text="0 đ"
                                               style="-fx-font-weight: bold; -fx-text-fill: #1f2937; -fx-font-size: 13px;"/>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-padding: 4 0 0 0;">
                                    <children>
                                        <Label text="Giảm giá voucher:"
                                               style="-fx-text-fill: #6b7280; -fx-font-size: 12px;" prefWidth="130.0"/>
                                        <Label fx:id="lblDiscount" text="0 đ"
                                               style="-fx-text-fill: #10b981; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                                    </children>
                                </HBox>
                                <Region prefHeight="8.0" style="-fx-background-color: #e5e7eb; -fx-max-height: 1;"/>
                                <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-padding: 8 0 0 0;">
                                    <children>
                                        <Label text="TỔNG CỘNG:"
                                               style="-fx-font-weight: bold; -fx-text-fill: #1f2937;
                                                      -fx-font-size: 13px;" prefWidth="130.0"/>
                                        <Label fx:id="lblTotalPrice" text="0 đ"
                                               style="-fx-font-size: 20px; -fx-font-weight: bold;
                                                      -fx-text-fill: #1d4ed8;"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                    </children>
                </VBox>

            </children>
        </GridPane>

    </children>
</VBox>
