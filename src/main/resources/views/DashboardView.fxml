<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity"
      minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="1176.0" prefWidth="1100.0"
      spacing="24.0"
      stylesheets="@../css/dashboardview/dashboardstyle.css"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.rentalcar.controller.dashboard.DashboardController">

   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="28.0"/>
   </padding>

   <children>

      <!-- ===== HEADER ===== -->
      <HBox alignment="CENTER_LEFT" prefHeight="46.0">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Tổng quan">
                     <font><Font name="System Bold" size="30.0"/></font>
                  </Text>
                  <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"
                         text="Xin chào! Đây là tổng quan hoạt động hôm nay."/>
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button mnemonicParsing="false" onAction="#showCreateContractModal"
                    prefHeight="46.0" prefWidth="195.0"
                    styleClass="btn-new" text="＋  Tạo đơn mới" textFill="WHITE">
               <font><Font name="System Bold" size="15.0"/></font>
            </Button>
         </children>
      </HBox>

      <!-- ===== 4 STAT CARDS ===== -->
      <HBox prefHeight="120.0" spacing="20.0">
         <children>

            <!-- Card 1: Doanh thu hôm nay -->
            <AnchorPane prefHeight="120.0" styleClass="card-blue" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="card-title" text="Doanh thu hôm nay"
                         AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0"/>
                  <Label fx:id="label_today_revenue" styleClass="card-value" text="--"
                         AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="40.0">
                     <font><Font name="System Bold" size="22.0"/></font>
                  </Label>
                  <Label styleClass="card-sub" text="↗  So với hôm qua"
                         AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="85.0"/>
                  <ImageView fitHeight="48.0" fitWidth="48.0" opacity="0.18"
                             pickOnBounds="true" preserveRatio="true"
                             AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="22.0">
                     <image><Image url="@../icon/dashboardform/dollar.png"/></image>
                  </ImageView>
               </children>
            </AnchorPane>

            <!-- Card 2: Doanh thu tháng -->
            <AnchorPane prefHeight="120.0" styleClass="card-green" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="card-title" text="Doanh thu tháng này"
                         AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0"/>
                  <Label fx:id="label_monthly_revenue" styleClass="card-value" text="--"
                         AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="40.0">
                     <font><Font name="System Bold" size="22.0"/></font>
                  </Label>
                  <Label styleClass="card-sub" text="📈  Tháng hiện tại"
                         AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="85.0"/>
                  <ImageView fitHeight="48.0" fitWidth="48.0" opacity="0.18"
                             pickOnBounds="true" preserveRatio="true"
                             AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="22.0">
                     <image><Image url="@../icon/dashboardform/growth.png"/></image>
                  </ImageView>
               </children>
            </AnchorPane>

            <!-- Card 3: Đơn đang hoạt động -->
            <AnchorPane prefHeight="120.0" styleClass="card-purple" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="card-title" text="Đơn đang hoạt động"
                         AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0"/>
                  <Label fx:id="label_active_contracts" styleClass="card-value" text="--"
                         AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="38.0">
                     <font><Font name="System Bold" size="30.0"/></font>
                  </Label>
                  <Label styleClass="card-sub" text="🕒  Đơn đang thuê xe"
                         AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="85.0"/>
                  <ImageView fitHeight="48.0" fitWidth="48.0" opacity="0.18"
                             pickOnBounds="true" preserveRatio="true"
                             AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="22.0">
                     <image><Image url="@../icon/dashboardform/invoice.png"/></image>
                  </ImageView>
               </children>
            </AnchorPane>

            <!-- Card 4: Xe đang cho thuê -->
            <AnchorPane prefHeight="120.0" styleClass="card-orange" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="card-title" text="Xe đang cho thuê"
                         AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="14.0"/>
                  <Label fx:id="label_status" styleClass="card-value" text="--"
                         AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="38.0">
                     <font><Font name="System Bold" size="30.0"/></font>
                  </Label>
                  <Label fx:id="label_status_available" styleClass="card-sub" text="--"
                         AnchorPane.leftAnchor="18.0" AnchorPane.topAnchor="85.0"/>
                  <ImageView fitHeight="56.0" fitWidth="70.0" opacity="0.18"
                             pickOnBounds="true" preserveRatio="true"
                             AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="20.0">
                     <image><Image url="@../icon/dashboardform/card-moto.png"/></image>
                  </ImageView>
               </children>
            </AnchorPane>

         </children>
      </HBox>

      <!-- ===== 3 ALERT BANNERS ===== -->
      <VBox spacing="12.0">
         <children>

            <!-- Alert đỏ: Đơn quá hạn -->
            <HBox alignment="CENTER_LEFT" prefHeight="68.0" styleClass="alert-red">
               <padding><Insets left="20.0" right="20.0"/></padding>
               <children>
                  <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                     <image><Image url="@../icon/dashboardform/exclamation.png"/></image>
                  </ImageView>
                  <VBox spacing="3.0">
                     <HBox.margin><Insets left="14.0"/></HBox.margin>
                     <children>
                        <Label styleClass="alert-title-red" text="Đơn quá hạn"/>
                        <Label fx:id="label_overdue_count" styleClass="alert-sub-red"
                               text="3 đơn chưa trả xe đúng hạn"/>
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Alert vàng: Xe bảo dưỡng -->
            <HBox alignment="CENTER_LEFT" prefHeight="68.0" styleClass="alert-yellow">
               <padding><Insets left="20.0" right="20.0"/></padding>
               <children>
                  <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                     <image><Image url="@../icon/mainform/btn-bell.png"/></image>
                  </ImageView>
                  <VBox spacing="3.0">
                     <HBox.margin><Insets left="14.0"/></HBox.margin>
                     <children>
                        <Label styleClass="alert-title-yellow" text="Xe cần bảo dưỡng"/>
                        <Label fx:id="label_maintenance_count" styleClass="alert-sub-yellow"
                               text="2 xe đã đạt km bảo dưỡng"/>
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Alert xanh: Voucher sắp hết -->
            <HBox alignment="CENTER_LEFT" prefHeight="68.0" styleClass="alert-blue">
               <padding><Insets left="20.0" right="20.0"/></padding>
               <children>
                  <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                     <image><Image url="@../icon/dashboardform/marketing.png"/></image>
                  </ImageView>
                  <VBox spacing="3.0">
                     <HBox.margin><Insets left="14.0"/></HBox.margin>
                     <children>
                        <Label styleClass="alert-title-blue" text="Voucher sắp hết lượt"/>
                        <Label fx:id="label_voucher_warning" styleClass="alert-sub-blue"
                               text="WELCOME2024 còn 5 lượt"/>
                     </children>
                  </VBox>
               </children>
            </HBox>

         </children>
      </VBox>

      <!-- ===== BẢNG ĐƠN GẦN ĐÂY ===== -->
      <VBox spacing="0.0" styleClass="table_container" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="16.0" left="20.0" right="20.0" top="16.0"/>
         </padding>
         <children>

            <!-- Table header -->
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 12 0;">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #1e293b;"
                         text="Đơn thuê gần đây"/>
                  <Region HBox.hgrow="ALWAYS"/>
                  <Label fx:id="label_recent_count"
                         style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;
                                      -fx-background-color: #f1f5f9; -fx-padding: 4 12;
                                      -fx-background-radius: 12;"
                         text="5 đơn gần nhất"/>
               </children>
            </HBox>

            <!-- TableView -->
            <TableView fx:id="tableContracts" prefHeight="380.0" VBox.vgrow="ALWAYS">
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
               </columnResizePolicy>
               <columns>
                  <TableColumn fx:id="colCode"     prefWidth="140.0" text="MÃ HĐ"/>
                  <TableColumn fx:id="colCustomer" prefWidth="220.0" text="KHÁCH HÀNG"/>
                  <TableColumn fx:id="colVehicle"  prefWidth="180.0" text="BIỂN SỐ XE"/>
                  <TableColumn fx:id="colStatus"   prefWidth="160.0" text="TRẠNG THÁI"/>
                  <TableColumn fx:id="colTotal"    prefWidth="170.0" text="TỔNG TIỀN"/>
                  <TableColumn fx:id="colAction"   prefWidth="130.0" text="THAO TÁC"/>
               </columns>
            </TableView>

         </children>
      </VBox>

   </children>
</VBox>